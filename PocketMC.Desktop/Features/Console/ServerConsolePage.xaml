<Page x:Class="PocketMC.Desktop.Features.Console.ServerConsolePage" xmlns:loc="clr-namespace:PocketMC.Desktop.Localization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:intel="clr-namespace:PocketMC.Desktop.Features.Intelligence"
      xmlns:infra="clr-namespace:PocketMC.Desktop.Infrastructure"
      Title="{loc:Tr 'Server Console'}"
      PreviewKeyDown="Page_PreviewKeyDown">

    <Grid x:Name="PageRoot" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: Console actions -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="{loc:Tr 'Back'}" Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowLeft24}" Click="BtnBack_Click" Cursor="Hand" Margin="0,0,12,0"
                       ToolTip="{loc:Tr 'Back to Dashboard (Escape)'}"
                       AutomationProperties.Name="{loc:Tr 'Back to Dashboard (Escape)'}"/>

            <ToggleButton x:Name="BtnAutoScroll" Grid.Column="1" Content="{loc:Tr 'Auto-scroll'}"
                          IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" Padding="12,5"
                          AutomationProperties.Name="{loc:Tr 'Toggle console auto-scrolling'}"/>

            <ui:Button Grid.Column="2" Content="{loc:Tr 'Copy Logs'}" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Copy24}" Click="BtnCopyLogs_Click" Cursor="Hand" Margin="0,0,8,0"
                       ToolTip="{loc:Tr 'Copy logs to clipboard'}"
                       AutomationProperties.Name="{loc:Tr 'Copy console logs to clipboard'}"/>

            <ui:TextBox x:Name="TxtLogSearch" Grid.Column="3" PlaceholderText="{loc:Tr 'Search logs...'}"
                        Margin="0,0,4,0" MinWidth="160" VerticalAlignment="Center"
                        TextChanged="TxtLogSearch_TextChanged"
                        KeyDown="TxtLogSearch_KeyDown"
                        AutomationProperties.Name="{loc:Tr 'Search console logs'}"/>

            <ToggleButton Grid.Column="4" Content=".*" ToolTip="{loc:Tr 'Use Regex'}"
                          IsChecked="{Binding IsRegexEnabled}"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Width="32" Height="32" Padding="0" Cursor="Hand"
                          AutomationProperties.Name="{loc:Tr 'Toggle regular expression search filter'}"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <ToggleButton Content="{loc:Tr 'Chat'}" IsChecked="{Binding IsFilterChat}" Margin="0,0,4,0" Padding="8,4" Cursor="Hand" AutomationProperties.Name="{loc:Tr 'Filter chat logs'}"/>
                <ToggleButton Content="{loc:Tr 'Info'}" IsChecked="{Binding IsFilterInfo}" Margin="0,0,4,0" Padding="8,4" Cursor="Hand" AutomationProperties.Name="{loc:Tr 'Filter informational logs'}"/>
                <ToggleButton Content="{loc:Tr 'Warn'}" IsChecked="{Binding IsFilterWarn}" Margin="0,0,4,0" Padding="8,4" Cursor="Hand" AutomationProperties.Name="{loc:Tr 'Filter warning logs'}"/>
                <ToggleButton Content="{loc:Tr 'Error'}" IsChecked="{Binding IsFilterError}" Margin="0,0,4,0" Padding="8,4" Cursor="Hand" AutomationProperties.Name="{loc:Tr 'Filter error logs'}"/>
                <ToggleButton Content="{loc:Tr 'Sys'}" IsChecked="{Binding IsFilterSystem}" Padding="8,4" Cursor="Hand" AutomationProperties.Name="{loc:Tr 'Filter system logs'}"/>
            </StackPanel>

            <ui:Button Grid.Column="6" Content="{Binding PlayerStatus}" Appearance="Secondary"
                       Icon="{ui:SymbolIcon People24}" Click="BtnPlayers_Click" Cursor="Hand" Margin="0,0,8,0"
                       ToolTip="{loc:Tr 'Manage online players'}"
                       AutomationProperties.Name="{loc:Tr 'Manage online players'}"
                       IsEnabled="{Binding CanUseLiveServerControls}"/>

            <ui:Button Grid.Column="7" Content="{loc:Tr 'Stop Server'}" Appearance="Danger"
                       Icon="{ui:SymbolIcon Stop24}" Click="BtnStop_Click" Cursor="Hand" Margin="0,0,8,0"
                       ToolTip="{loc:Tr 'Stop server process'}"
                       AutomationProperties.Name="{loc:Tr 'Stop server process'}"
                       IsEnabled="{Binding CanStopServer}"/>

            <ui:Button Grid.Column="8" Content="{loc:Tr 'Restart'}" Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowSync24}" Click="BtnRestart_Click" Cursor="Hand" Margin="0,0,8,0"
                       ToolTip="{loc:Tr 'Restart server process'}"
                       AutomationProperties.Name="{loc:Tr 'Restart server process'}"
                       IsEnabled="{Binding CanUseLiveServerControls}"/>

            <ui:Button Grid.Column="9" Content="{loc:Tr 'AI Summary'}"
                       Style="{StaticResource AiActionButtonStyle}"
                       Icon="{ui:SymbolIcon Sparkle24}" Click="BtnAiSummary_Click" Cursor="Hand"
                       ToolTip="{loc:Tr 'Generate AI session summary'}"
                       AutomationProperties.Name="{loc:Tr 'Generate AI session summary'}"/>
        </Grid>

        <!-- Console output area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="AiPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ui:InfoBar Grid.Row="0" x:Name="ReadOnlyLogInfoBar"
                             Title="{loc:Tr 'Read-only console'}"
                             Message="Showing last session log. Start the server to create a new live session."
                             Severity="Informational" Margin="0,0,0,10"
                             IsClosable="False"
                             Visibility="Collapsed"/>

                <ui:InfoBar Grid.Row="1" x:Name="ResourceWarningBar"
                             Title="{loc:Tr 'High Resource Usage'}"
                             Message="Your server is using over 80% of its assigned RAM. Performance may be impacted."
                             Severity="Warning" Margin="0,0,0,10"
                             IsClosable="False"
                             Visibility="Collapsed">
                    <ui:Button Content="{loc:Tr 'Optimize'}" Appearance="Primary" Click="BtnOptimize_Click"
                               Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </ui:InfoBar>

                <Border Grid.Row="2" x:Name="CrashBanner" Background="#EE1A1A1A" BorderBrush="#FF4444" BorderThickness="1,1,1,2" CornerRadius="8" Padding="0" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Actions -->
                        <Border Grid.Row="0" Background="#33FF4444" CornerRadius="7,7,0,0" Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,8,0" Foreground="#FF6B6B"/>
                                    <ui:TextBlock FontTypography="Subtitle" Text="{loc:Tr 'Critical Crash Detected!'}" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="BtnCrashAiAnalyze" Content="{loc:Tr 'Analyze with AI'}"
                                               Style="{StaticResource AiActionButtonStyle}"
                                               Icon="{ui:SymbolIcon Sparkle20}"
                                               Cursor="Hand"
                                               Margin="0,0,8,0" Padding="8,4"
                                               Click="BtnCrashAiAnalyze_Click"/>
                                    <ui:Button Content="{loc:Tr 'Copy Report'}" Appearance="Secondary" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Padding="8,4" Click="BtnCopyCrash_Click"/>
                                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" Padding="4" Click="BtnDismissCrash_Click" ToolTip="{loc:Tr 'Hide Banner'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                            <TextBlock x:Name="TxtCrashLog" Foreground="#FF6B6B" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" Opacity="0.9"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Log View with Selectable Text -->
                <RichTextBox x:Name="LogRichTextBox" Grid.Row="3"
                             Background="Transparent" BorderThickness="0"
                             IsReadOnly="True"
                             IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="4,2">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr 'AI Analyze Selection'}"
                                      Icon="{ui:SymbolIcon Sparkle16}"
                                      Click="BtnAnalyzeSelection_Click"/>
                            <MenuItem Header="{loc:Tr 'Copy'}" Command="ApplicationCommands.Copy" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                    <FlowDocument PagePadding="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="14">
                        <Paragraph x:Name="LogParagraph" Margin="0" LineHeight="20" />
                    </FlowDocument>
                </RichTextBox>
            </Grid>
        </Border>
            <!-- AI Side Panel Content -->
            <Border Grid.Column="1" Background="#252525" Margin="8,0,0,0" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="8,8,0,0" Padding="12,8">
                        <Grid>
                            <ui:TextBlock Text="{loc:Tr 'AI Intelligence'}" FontTypography="Caption" Foreground="White" VerticalAlignment="Center"/>
                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}"
                                       HorizontalAlignment="Right" Click="BtnCloseAiPanel_Click" Padding="4"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <ui:TextBlock x:Name="TxtAiStatus" Text="{loc:Tr 'Ready to analyze...'}" Foreground="#888"
                                           FontStyle="Italic" Margin="0,0,0,16" Visibility="Collapsed"/>
                            <ui:ProgressRing x:Name="AiProgress" IsIndeterminate="True" Height="28" Width="28"
                                              HorizontalAlignment="Center" Margin="0,30" Visibility="Collapsed"/>
                        </StackPanel>

                        <intel:NativeMarkdownViewer x:Name="TxtAiResponse" Grid.Row="1" />
                    </Grid>

                    <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="0,0,8,8" Padding="12,8">
                        <ui:TextBlock Text="{loc:Tr 'Powered by PocketMC Intelligence'}" FontTypography="Caption"
                                       Foreground="#666" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="TxtCommand" Grid.Column="0" PlaceholderText="{loc:Tr 'Type a command...'}"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding CanUseLiveServerControls}"
                        KeyDown="TxtCommand_KeyDown"
                        AutomationProperties.Name="{loc:Tr 'Server console command input'}"/>
            <ui:Button Grid.Column="1" Content="{loc:Tr 'Send'}" Appearance="Primary"
                       Icon="{ui:SymbolIcon Send24}" Click="BtnSend_Click" Cursor="Hand"
                       IsEnabled="{Binding CanUseLiveServerControls}"
                       AutomationProperties.Name="{loc:Tr 'Send console command'}"/>
        </Grid>
    </Grid>
</Page>
