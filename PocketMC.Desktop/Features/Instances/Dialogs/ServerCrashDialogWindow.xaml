<ui:FluentWindow x:Class="PocketMC.Desktop.Features.Instances.Dialogs.ServerCrashDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:intel="clr-namespace:PocketMC.Desktop.Features.Intelligence"
        Title="Server Crash Detected"
        Width="740"
        SizeToContent="Height"
        MinWidth="680" MaxWidth="840"
        MinHeight="0" MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyboardNavigation.TabNavigation="Cycle"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Server Crash" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Warning Icon -->
                <Border Width="48" Height="48" CornerRadius="24" Background="#3B202A" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="26" Foreground="#F38BA8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Server Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtServerName" Text="Server Name" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <Border Background="#F38BA8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCategoryBadge" Text="Crashed" FontSize="11" FontWeight="Bold" Foreground="#1E1E2E"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtServerDetails" Text="Fabric 1.20.1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Summary Card -->
            <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="14,12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="TxtCrashTitle" Text="Crash Summary" FontSize="13" FontWeight="SemiBold" Foreground="#F38BA8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtCrashSummary" Text="The server encountered an unhandled exception." FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </ui:Card>

            <!-- Log / AI Analysis Section -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section Header with View Toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtLogSectionTitle" Text="Diagnostic &amp; Exception Log" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <ui:Button x:Name="BtnToggleView"
                               Content="View Logs"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Code20}"
                               Padding="6,2"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               AutomationProperties.Name="Toggle crash log view"
                               Click="BtnToggleView_Click"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- Log Viewer (dark terminal container) -->
                <Border x:Name="LogContainer" Grid.Row="1" Background="#11111B" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TextBox x:Name="TxtLogViewer"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#CDD6F4"
                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                             FontSize="11"
                             MaxHeight="240"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Diagnostic crash log viewer"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"/>
                </Border>

                <!-- AI Loading State -->
                <Border x:Name="AiLoadingContainer" Grid.Row="1" Background="#11111B" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
                    <Grid MinHeight="160" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" Margin="0,0,0,12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Analyzing crash with AI..." FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtAiProviderStatus" Text="Identifying root cause and remediation instructions..." FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AI Response Markdown Viewer (separate container, same style as server console/settings) -->
                <ui:Card x:Name="AiMarkdownContainer" Grid.Row="1" Padding="16,12" Visibility="Collapsed">
                    <intel:NativeMarkdownViewer x:Name="AiMarkdownViewer" MaxHeight="300" />
                </ui:Card>
            </Grid>

            <!-- Actions Bar -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnAnalyzeWithAi"
                               Content="Analyze with AI"
                               Style="{StaticResource AiActionButtonStyle}"
                               Icon="{ui:SymbolIcon Sparkle20}"
                               Cursor="Hand"
                               Padding="10,6"
                               AutomationProperties.Name="Analyze crash with AI"
                               Click="BtnAnalyzeWithAi_Click"
                               Margin="0,0,6,0"/>

                    <ui:Button x:Name="BtnCopyLogs"
                               Content="Copy Logs"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Copy20}"
                               Padding="10,6"
                               AutomationProperties.Name="Copy diagnostic crash logs"
                               Click="BtnCopyLogs_Click"
                               Margin="0,0,6,0"/>

                    <ui:Button x:Name="BtnOpenReport"
                               Content="Open File"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon DocumentBulletList20}"
                               Padding="10,6"
                               Click="BtnOpenReport_Click"
                               ToolTip="Open crash report file in editor"
                               AutomationProperties.Name="Open crash report file"
                               Margin="0,0,6,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnConsole"
                               Content="Console"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon WindowConsole20}"
                               Padding="10,6"
                               AutomationProperties.Name="Open server live console"
                               Click="BtnConsole_Click"
                               Margin="0,0,6,0"/>

                    <ui:Button x:Name="BtnClose"
                               Content="Dismiss"
                               Appearance="Secondary"
                               MinWidth="72"
                               Padding="12,6"
                               Click="BtnClose_Click"
                               IsDefault="True"
                               IsCancel="True"
                               AutomationProperties.Name="Dismiss crash dialog (Escape)"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
