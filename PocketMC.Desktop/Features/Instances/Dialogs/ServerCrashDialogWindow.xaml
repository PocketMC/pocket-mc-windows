<ui:FluentWindow x:Class="PocketMC.Desktop.Features.Instances.Dialogs.ServerCrashDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Server Crash Detected"
        Width="640"
        SizeToContent="Height"
        MinWidth="520" MaxWidth="720"
        MinHeight="0" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Server Crash" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Warning Icon -->
                <Border Width="48" Height="48" CornerRadius="24" Background="#3B202A" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="26" Foreground="#F38BA8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Server Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtServerName" Text="Server Name" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <Border Background="#F38BA8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCategoryBadge" Text="Crashed" FontSize="11" FontWeight="Bold" Foreground="#1E1E2E"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtServerDetails" Text="Fabric 1.20.1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Summary Card -->
            <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="14,12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <StackPanel>
                    <TextBlock x:Name="TxtCrashTitle" Text="Crash Summary" FontSize="13" FontWeight="SemiBold" Foreground="#F38BA8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtCrashSummary" Text="The server encountered an unhandled exception." FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </ui:Card>

            <!-- Log / Stacktrace Preview -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Diagnostic &amp; Exception Log" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>

                <Border Grid.Row="1" Background="#11111B" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLogViewer"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#CDD6F4"
                                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Actions Bar -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="BtnCopyLogs"
                               Content="Copy Crash Logs"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Copy20}"
                               Padding="12,7"
                               Click="BtnCopyLogs_Click"
                               Margin="0,0,8,0"/>

                    <ui:Button x:Name="BtnOpenReport"
                               Content="Open Crash Report"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon DocumentBulletList20}"
                               Padding="12,7"
                               Click="BtnOpenReport_Click"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="BtnConsole"
                               Content="View Console"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon WindowConsole20}"
                               Padding="12,7"
                               Click="BtnConsole_Click"
                               Margin="0,0,8,0"/>

                    <ui:Button x:Name="BtnClose"
                               Content="Dismiss"
                               Appearance="Primary"
                               MinWidth="80"
                               Padding="14,7"
                               Click="BtnClose_Click"
                               IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
