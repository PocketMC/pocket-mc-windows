<Page x:Class="PocketMC.Desktop.Features.Settings.ServerSettingsPage" xmlns:loc="clr-namespace:PocketMC.Desktop.Localization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:intel="clr-namespace:PocketMC.Desktop.Features.Intelligence"
      xmlns:infra="clr-namespace:PocketMC.Desktop.Infrastructure"
      mc:Ignorable="d"
      d:DesignHeight="1200" d:DesignWidth="950"
      Title="{loc:Tr 'Server Settings'}"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        <presentation:InverseBooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" xmlns:presentation="clr-namespace:PocketMC.Desktop.Core.Presentation"/>
        <presentation:InverseBooleanConverter x:Key="InvertedBooleanConverter" xmlns:presentation="clr-namespace:PocketMC.Desktop.Core.Presentation"/>
        <presentation:NullOrEmptyToVisibilityConverter x:Key="VisibleIfNotEmpty" xmlns:presentation="clr-namespace:PocketMC.Desktop.Core.Presentation"/>
        <settings:MinecraftMotdConverter x:Key="MotdConverter" xmlns:settings="clr-namespace:PocketMC.Desktop.Features.Settings"/>

        <ImageBrush x:Key="DirtBackground" ImageSource="pack://application:,,,/Assets/dark_dirt.png" Viewport="0,0,45,46" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" />

        <!-- Premium Styles -->
        <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SettingsHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SettingsSubtext">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28,20,28,24" VerticalAlignment="Stretch">
        <DockPanel LastChildFill="True">

            <!-- Title Section -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}"
                               Appearance="Transparent"
                               Command="{Binding CancelCommand}"
                               Margin="0,0,12,0"
                               Padding="6" />
                    <ui:TextBlock FontTypography="Title"
                                  Text="{loc:Tr 'Server Configurations'}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:Tr 'Modify your instance setup, install addons, configure automated tasks and manage world files.'}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           Margin="48,0,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Bottom Action Bar -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,16,0,0"
                    Padding="20,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Non-update footer content (toggle, warnings) -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center"
                                Visibility="{Binding IsVersionUpdatesTabActive, Converter={StaticResource InvertedVisibilityConverter}}">
                        <!-- Auto-Start Toggle -->
                        <ui:ToggleSwitch IsChecked="{Binding General.AutoStartWithApp, Mode=TwoWay}" 
                                         Content="{loc:Tr 'Auto-start server at PocketMC startup'}" 
                                         Margin="0,4,24,4"
                                         VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource VisibleIfTrue}}" Margin="0,4,24,4">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Tr 'Unsaved changes detected'}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsRestartRequired, Converter={StaticResource VisibleIfTrue}}" Margin="0,4,24,4">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:Tr 'Server restart required to apply changes'}"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Update Status & Progress (stretches full width) -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0"
                                Visibility="{Binding IsVersionUpdatesTabActive, Converter={StaticResource VisibleIfTrue}}">
                        <StackPanel Visibility="{Binding VersionUpdates.StatusText, Converter={StaticResource VisibleIfNotEmpty}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="{Binding VersionUpdates.StatusText}"
                                           FontTypography="BodyStrong"
                                           FontSize="13"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            </StackPanel>
                            
                            <Grid Visibility="{Binding VersionUpdates.IsUpdateProgressVisible, Converter={StaticResource VisibleIfTrue}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding VersionUpdates.UpdateProgressValue}"
                                             Maximum="100" Height="4" HorizontalAlignment="Stretch"
                                             IsIndeterminate="{Binding VersionUpdates.IsUpdateProgressIndeterminate}"/>
                                <TextBlock Grid.Column="1" Text="{Binding VersionUpdates.ProgressDetailText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <ui:Button Content="{loc:Tr 'Discard'}" Appearance="Secondary" Margin="0,0,12,0" Command="{Binding CancelCommand}"/>
                        <ui:Button Content="{loc:Tr 'Save Changes'}" Appearance="Primary" Command="{Binding SaveCommand}" MinWidth="140"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Layout Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:NavigationView Grid.Column="0"
                                   x:Name="SidebarList"
                                   PaneDisplayMode="Left"
                                   IsPaneToggleVisible="False"
                                   IsBackButtonVisible="Collapsed">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="{loc:Tr 'Identity &amp; Performance'}" Icon="{ui:SymbolIcon Settings24}" Click="NavItem_Click" IsActive="True"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'Version &amp; Updates'}" Icon="{ui:SymbolIcon ArrowSync24}" Click="NavItem_Click"
                                               Visibility="{Binding VersionUpdates.IsUpdateSupported, Converter={StaticResource VisibleIfTrue}}"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'Gameplay Rules'}" Icon="{ui:SymbolIcon Globe24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'World &amp; Files'}" Icon="{ui:SymbolIcon Folder24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'Addons (Plugins/Mods)'}" Icon="{ui:SymbolIcon Add24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'Automated Backups'}" Icon="{ui:SymbolIcon Save24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'Restart &amp; Recovery'}" Icon="{ui:SymbolIcon ArrowSync24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'Advanced Editor'}" Icon="{ui:SymbolIcon Code24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem Content="{loc:Tr 'AI Summaries'}" Icon="{ui:SymbolIcon BrainCircuit24}" Click="NavItem_Click"
                                               Visibility="{Binding IsAiSummarizationAvailable, Converter={StaticResource VisibleIfTrue}}"/>
                    </ui:NavigationView.MenuItems>
                </ui:NavigationView>

                <Border x:Name="ContentAreaCard" Grid.Column="2" VerticalAlignment="Stretch">
                    <Grid>
                        <!-- Settings Tab Skeleton Loader (Zero-delay, active only during tab/page load) -->
                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource VisibleIfTrue}}">
                            <Border Style="{StaticResource SkeletonCardBorder}" Height="120" Margin="0,0,0,12" Padding="16,14">
                                <StackPanel>
                                    <Border Style="{StaticResource SkeletonElement}" Height="18" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource SkeletonElement}" Height="14" Width="320" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                                    <Border Style="{StaticResource SkeletonElement}" Height="36" Width="400" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SkeletonCardBorder}" Height="80" Margin="0,0,0,12" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonElement}" Height="16" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource SkeletonElement}" Height="12" Width="300" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonElement}" Width="40" Height="22" CornerRadius="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SkeletonCardBorder}" Height="80" Margin="0,0,0,12" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource SkeletonElement}" Height="16" Width="200" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource SkeletonElement}" Height="12" Width="280" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SkeletonElement}" Width="40" Height="22" CornerRadius="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="0" VerticalAlignment="Stretch"
                                    Visibility="{Binding IsLoading, Converter={StaticResource InvertedVisibilityConverter}}">
                            <TabControl.Resources><Style TargetType="TabPanel"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>

                            <!-- TAB 1: IDENTITY & PERFORMANCE -->
                            <TabItem Header="{loc:Tr 'Identity'}">
                            <ScrollViewer x:Name="GeneralScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>
                                    <ui:CardExpander Header="{loc:Tr 'Visual Identity'}" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,0,12" IsExpanded="True">
                                        <StackPanel Margin="16,8,16,16">
                                            <!-- Instance Alias & Description -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Tr 'Instance Name (Label)'}" Style="{StaticResource SettingsHeader}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{loc:Tr 'The display name for this instance in your dashboard.'}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,8"/>
                                                    <ui:TextBox Text="{Binding General.InstanceName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'My Epic Server'}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Tr 'Instance Description'}" Style="{StaticResource SettingsHeader}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{loc:Tr &quot;A short note about this instance's purpose or configuration.&quot;}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,8"/>
                                                    <ui:TextBox Text="{Binding General.InstanceDescription, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'Testing new mods...'}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Separator Margin="0,0,0,20" Opacity="0.15"/>

                                            <!-- Interactive Dummy Server Card -->
                                            <Border Background="{StaticResource DirtBackground}" BorderThickness="2" BorderBrush="#000000" Padding="4" Margin="0,0,0,16" CornerRadius="0"
                                                    Visibility="{Binding IsJavaSettings, Converter={StaticResource VisibleIfTrue}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Server Icon -->
                                                        <ColumnDefinition Width="6"/> <!-- Tight Spacing -->
                                                        <ColumnDefinition Width="*"/> <!-- Server Info & MOTD -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon area with Edit Hover -->
                                                    <Grid Grid.Column="0" Width="64" Height="64">
                                                        <Border BorderThickness="1" BorderBrush="#333333" Background="#111">
                                                            <Image Source="{Binding General.ServerIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <ui:Button Appearance="Primary" Padding="4" Command="{Binding General.BrowseIconCommand}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="-8,-8,0,0" ToolTip="{loc:Tr 'Change Server Icon'}">
                                                            <ui:SymbolIcon Symbol="Edit16" />
                                                        </ui:Button>
                                                    </Grid>

                                                    <Grid Grid.Column="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/> <!-- Top row: Name -->
                                                            <RowDefinition Height="*"/> <!-- Bottom row: MOTD -->
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,-2,0,2">
                                                            <!-- Server Name (Bound to InstanceName) -->
                                                            <TextBlock Text="{Binding General.InstanceName, FallbackValue='Minecraft Server'}" FontFamily="Consolas" FontSize="15" Foreground="White" FontWeight="SemiBold">
                                                                <TextBlock.Effect>
                                                                    <DropShadowEffect BlurRadius="0" ShadowDepth="2" Opacity="1" Color="Black" />
                                                                </TextBlock.Effect>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- MOTD Display & Editor -->
                                                        <Grid Grid.Row="1" VerticalAlignment="Top">
                                                            <!-- Display Mode -->
                                                            <StackPanel x:Name="MotdDisplayMode">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ContentControl Content="{Binding General.Motd, Converter={StaticResource MotdConverter}}" FontFamily="Consolas" FontSize="14">
                                                                        <ContentControl.Effect>
                                                                            <DropShadowEffect BlurRadius="0" ShadowDepth="2" Opacity="1" Color="Black" />
                                                                        </ContentControl.Effect>
                                                                    </ContentControl>
                                                                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Edit16}" Click="BtnEditMotd_Click" Margin="4,-2,0,0" Padding="2" ToolTip="{loc:Tr 'Edit MOTD'}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Signal Bars Dummy -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,4,0">
                                                        <TextBlock FontSize="15" FontFamily="Consolas" Foreground="#AAAAAA" VerticalAlignment="Top" Margin="0,0,6,0" FontWeight="SemiBold">
                                                            <Run Text="0/"/><Run Text="{Binding World.MaxPlayers, FallbackValue=20}"/>
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" ShadowDepth="2" Opacity="1" Color="Black"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <Grid Width="16" Height="14" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <Rectangle Width="3" Height="4" Fill="#00FF00" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                                            <Rectangle Width="3" Height="7" Fill="#00FF00" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                                                            <Rectangle Width="3" Height="10" Fill="#00FF00" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                                            <Rectangle Width="3" Height="14" Fill="#00FF00" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- MOTD Editor Panel (shown below the preview card) -->
                                            <StackPanel x:Name="MotdEditorMode" Visibility="Collapsed" Margin="0,8,0,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Color Palette (left side) -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Tr 'Colors'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <WrapPanel MaxWidth="200">
                                                            <Button Content="§0" ToolTip="{loc:Tr 'Black'}" Click="BtnInsertMotdColor_Click" Tag="\u00A70" Background="#000000" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§1" ToolTip="{loc:Tr 'Dark Blue'}" Click="BtnInsertMotdColor_Click" Tag="\u00A71" Background="#0000AA" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§2" ToolTip="{loc:Tr 'Dark Green'}" Click="BtnInsertMotdColor_Click" Tag="\u00A72" Background="#00AA00" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§3" ToolTip="{loc:Tr 'Dark Aqua'}" Click="BtnInsertMotdColor_Click" Tag="\u00A73" Background="#00AAAA" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§4" ToolTip="{loc:Tr 'Dark Red'}" Click="BtnInsertMotdColor_Click" Tag="\u00A74" Background="#AA0000" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§5" ToolTip="{loc:Tr 'Dark Purple'}" Click="BtnInsertMotdColor_Click" Tag="\u00A75" Background="#AA00AA" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§6" ToolTip="{loc:Tr 'Gold'}" Click="BtnInsertMotdColor_Click" Tag="\u00A76" Background="#FFAA00" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§7" ToolTip="{loc:Tr 'Gray'}" Click="BtnInsertMotdColor_Click" Tag="\u00A77" Background="#AAAAAA" Foreground="Black" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§8" ToolTip="{loc:Tr 'Dark Gray'}" Click="BtnInsertMotdColor_Click" Tag="\u00A78" Background="#555555" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="§9" ToolTip="{loc:Tr 'Blue'}" Click="BtnInsertMotdColor_Click" Tag="\u00A79" Background="#5555FF" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr '§a'}" ToolTip="{loc:Tr 'Green'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7a" Background="#55FF55" Foreground="Black" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr '§b'}" ToolTip="{loc:Tr 'Aqua'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7b" Background="#55FFFF" Foreground="Black" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr '§c'}" ToolTip="{loc:Tr 'Red'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7c" Background="#FF5555" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr '§d'}" ToolTip="{loc:Tr 'Light Purple'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7d" Background="#FF55FF" Foreground="White" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr '§e'}" ToolTip="{loc:Tr 'Yellow'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7e" Background="#FFFF55" Foreground="Black" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr '§f'}" ToolTip="{loc:Tr 'White'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7f" Background="#FFFFFF" Foreground="Black" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{loc:Tr 'Formatting'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,4"/>
                                                        <WrapPanel>
                                                            <Button Content="{loc:Tr 'B'}" ToolTip="{loc:Tr 'Bold (§l)'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7l" Background="#333" Foreground="Silver" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr 'I'}" ToolTip="{loc:Tr 'Italic (§o)'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7o" Background="#333" Foreground="Silver" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" FontStyle="Italic" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr 'U'}" ToolTip="{loc:Tr 'Underline (§n)'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7n" Background="#333" Foreground="Silver" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="{loc:Tr 'S'}" ToolTip="{loc:Tr 'Strikethrough (§m)'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7m" Background="#333" Foreground="Silver" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="TextBlock"><Setter Property="TextDecorations" Value="Strikethrough"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="?" ToolTip="{loc:Tr 'Obfuscated (§k)'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7k" Background="#333" Foreground="Silver" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                            <Button Content="{loc:Tr 'R'}" ToolTip="{loc:Tr 'Reset (§r)'}" Click="BtnInsertMotdColor_Click" Tag="\u00A7r" Background="#444" Foreground="#FF5555" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                                            <Button Content="↵" ToolTip="{loc:Tr 'New Line (\n)'}" Click="BtnInsertMotdColor_Click" Tag="\n" Background="#444" Foreground="#55FFFF" BorderThickness="0" Margin="0,0,2,2" Padding="4,2" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- Text Input + Save (right side) -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                        <TextBlock Text="{loc:Tr 'Raw MOTD Text'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <ui:TextBox x:Name="TxtMotdRaw" Text="{Binding General.Motd, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AcceptsReturn="False"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                                                            <ui:Button Appearance="Primary" Content="{loc:Tr 'Done'}" Icon="{ui:SymbolIcon Checkmark16}" Click="BtnSaveMotd_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Simple MOTD Editor (Non-Java) -->
                                            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsJavaSettings, Converter={StaticResource InvertedVisibilityConverter}}">
                                                <TextBlock Text="{Binding DisplayNameLabel, FallbackValue='Server Message (MOTD)'}" Style="{StaticResource SettingsHeader}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{loc:Tr 'The message displayed to players in the server list.'}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,8"/>
                                                <ui:TextBox Text="{Binding General.Motd, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'My Server'}" />
                                            </StackPanel>

                                        </StackPanel>
                                    </ui:CardExpander>

                                    <!-- Port Configuration -->
                                    <ui:CardExpander Header="{loc:Tr 'Port Configuration'}" Icon="{ui:SymbolIcon Globe24}" Margin="0,0,0,12" IsExpanded="True">
                                        <StackPanel Margin="16,8,16,16">

                                            <!-- Server Ports -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Tr 'Server Port'}" Style="{StaticResource SettingsHeader}" Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                                        <Run Text="{loc:Tr 'Minecraft 服务器监听的端口，默认为 '}"/>
                                                        <Run Text="{Binding DefaultServerPortText, Mode=OneWay}"/>
                                                        <Run Text="."/>
                                                    </TextBlock>
                                                    <ui:TextBox Text="{Binding General.ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="{Binding DefaultServerPortText, Mode=OneWay}" Width="160" ClearButtonEnabled="False" HorizontalAlignment="Left"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Visibility="{Binding SupportsGeyserSettings, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Tr 'Geyser Bedrock Port (UDP)'}" Style="{StaticResource SettingsHeader}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{loc:Tr 'The UDP port used by Bedrock players to connect via Geyser.'}"
                                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                    <ui:TextBox Text="{Binding General.GeyserBedrockPort, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="19132" Width="160" ClearButtonEnabled="False" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Grid>



                                        </StackPanel>
                                    </ui:CardExpander>

                                            <ui:CardExpander Header="{loc:Tr 'Resource Allocation'}" Icon="{ui:SymbolIcon TopSpeed24}" Margin="0,0,0,12" IsExpanded="True"
                                                             Visibility="{Binding SupportsJavaRuntimeSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel Margin="16,8,16,16">
                                            <TextBlock Text="{loc:Tr 'System RAM Limit:'}" Style="{StaticResource SettingsHeader}"/>
                                            <Grid Margin="0,5,0,15">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Tr '0.5GB'}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"/>
                                                <Slider Grid.Column="1" Value="{Binding Performance.MaxRam}" Minimum="512" Maximum="{Binding Performance.TotalRamMb}" TickFrequency="512" SmallChange="512" LargeChange="1024" IsSnapToTickEnabled="True"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Performance.MaxRamDisplay}" Margin="12,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>

                                            <TextBlock Text="{loc:Tr 'Startup JVM Arguments:'}" Style="{StaticResource SettingsHeader}" Margin="0,5,0,8"/>
                                            <ui:TextBox Text="{Binding Performance.AdvancedJvmArgs, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr '-XX:+UseG1GC ...'}"/>

                                            <TextBlock Text="{loc:Tr 'Custom Java Executable:'}" Style="{StaticResource SettingsHeader}" Margin="0,15,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ui:TextBox Text="{Binding Performance.JavaPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'Internal Java 17/21'}"/>
                                                <ui:Button Grid.Column="1" Content="{loc:Tr 'Browse'}" Command="{Binding Performance.BrowseJavaCommand}" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </ui:CardExpander>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{loc:Tr 'VersionUpdates'}" Visibility="{Binding VersionUpdates.IsUpdateSupported, Converter={StaticResource VisibleIfTrue}}">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0"
                                              Visibility="{Binding VersionUpdates.IsMainContentVisible, Converter={StaticResource VisibleIfTrue}}">
                                    <StackPanel>

                                        <!-- Version Update Card -->
                                        <ui:Card Padding="24" Margin="0,0,0,16" Visibility="{Binding VersionUpdates.HasTargetVersions, Converter={StaticResource VisibleIfTrue}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Current Version Info -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr 'Current Version'}" FontSize="12" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding VersionUpdates.CurrentServerVersion}" 
                                                                   FontSize="22" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                   VerticalAlignment="Bottom"/>
                                                        <TextBlock Text="{Binding VersionUpdates.CurrentServerType}" 
                                                                   FontSize="12" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                   VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Dotted Arrow -->
                                                <Grid Grid.Column="1" Margin="24,0,24,0" VerticalAlignment="Center">
                                                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill"
                                                          Stroke="{DynamicResource TextFillColorTertiaryBrush}" 
                                                          StrokeThickness="1.5"
                                                          StrokeDashArray="3 2"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                                    <Path Data="M 0 0 L 6 4 L 0 8" 
                                                          Stroke="{DynamicResource TextFillColorTertiaryBrush}" 
                                                          StrokeThickness="1.5" 
                                                          HorizontalAlignment="Right" 
                                                          VerticalAlignment="Center"
                                                          StrokeEndLineCap="Round" 
                                                          StrokeStartLineCap="Round" 
                                                          StrokeLineJoin="Round"/>
                                                </Grid>

                                                <!-- Target Version Selector -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{loc:Tr 'Update to'}" FontSize="12" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MaxWidth="240"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding VersionUpdates.TargetVersions}"
                                                                  SelectedItem="{Binding VersionUpdates.SelectedTargetVersion, Mode=TwoWay}"
                                                                  DisplayMemberPath="Id"
                                                                  IsEnabled="{Binding VersionUpdates.HasTargetVersions}"/>
                                                        <ui:Button Grid.Column="1"
                                                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                                                   Appearance="Secondary"
                                                                   Command="{Binding VersionUpdates.LoadTargetVersionsCommand}"
                                                                   Margin="6,0,0,0"
                                                                   ToolTip="{loc:Tr 'Refresh available versions'}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Update Button -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <ui:Button Content="{loc:Tr 'Update Server'}" 
                                                               Appearance="Primary" 
                                                               Command="{Binding VersionUpdates.ApplyMinecraftUpdateCommand}" 
                                                               Icon="{ui:SymbolIcon ArrowSync20}"/>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>

                                        <!-- Loader Update Card -->
                                        <ui:Card Padding="24" Margin="0,0,0,16" Visibility="{Binding VersionUpdates.HasTargetLoaderVersions, Converter={StaticResource VisibleIfTrue}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Current Loader Info -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr 'Current Loader'}" FontSize="12" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding VersionUpdates.CurrentLoaderVersion}" 
                                                                   FontSize="22" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                                   VerticalAlignment="Bottom"/>
                                                        <TextBlock Text="{loc:Tr 'Loader'}" 
                                                                   FontSize="12" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                   VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Dotted Arrow -->
                                                <Grid Grid.Column="1" Margin="24,0,24,0" VerticalAlignment="Center">
                                                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill"
                                                          Stroke="{DynamicResource TextFillColorTertiaryBrush}" 
                                                          StrokeThickness="1.5"
                                                          StrokeDashArray="3 2"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                                    <Path Data="M 0 0 L 6 4 L 0 8" 
                                                          Stroke="{DynamicResource TextFillColorTertiaryBrush}" 
                                                          StrokeThickness="1.5" 
                                                          HorizontalAlignment="Right" 
                                                          VerticalAlignment="Center"
                                                          StrokeEndLineCap="Round" 
                                                          StrokeStartLineCap="Round" 
                                                          StrokeLineJoin="Round"/>
                                                </Grid>

                                                <!-- Target Loader Selector -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{loc:Tr 'Update loader to'}" FontSize="12" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MaxWidth="240"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding VersionUpdates.TargetLoaderVersions}"
                                                                  SelectedItem="{Binding VersionUpdates.SelectedTargetLoaderVersion, Mode=TwoWay}"
                                                                  DisplayMemberPath="Version"
                                                                  IsEnabled="{Binding VersionUpdates.HasTargetLoaderVersions}"/>
                                                        <ui:Button Grid.Column="1"
                                                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                                                   Appearance="Secondary"
                                                                   Command="{Binding VersionUpdates.LoadTargetVersionsCommand}"
                                                                   Margin="6,0,0,0"
                                                                   ToolTip="{loc:Tr 'Refresh available versions'}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Update Button -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <ui:Button Content="{loc:Tr 'Update Loader'}" 
                                                               Appearance="Primary" 
                                                               Command="{Binding VersionUpdates.ApplyLoaderUpdateCommand}" 
                                                               Icon="{ui:SymbolIcon ArrowSync20}"/>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>

                                    </StackPanel>
                                </ScrollViewer>
                                
                                <!-- Empty state: already up to date -->
                                <StackPanel Visibility="{Binding VersionUpdates.IsEmptyStateVisible, Converter={StaticResource VisibleIfTrue}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-80,0,0">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr &quot;You're up to date!&quot;}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding VersionUpdates.TargetVersionStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: GAMEPLAY RULES -->
                        <TabItem Header="{loc:Tr 'Gameplay'}">
                            <ScrollViewer x:Name="GameplayScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>
                                    <ui:Card Padding="24" Margin="0,0,0,16"
                                             Visibility="{Binding IsJavaSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Core Rules'}" Style="{StaticResource SettingsHeader}" FontSize="18"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Default Gamemode:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ComboBox ItemsSource="{Binding World.Gamemodes}" SelectedItem="{Binding World.Gamemode, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'World Difficulty:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ComboBox ItemsSource="{Binding World.Difficulties}" SelectedItem="{Binding World.Difficulty, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Maximum Players:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ui:TextBox Text="{Binding World.MaxPlayers, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Spawn Protection Radius:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ui:TextBox Text="{Binding World.SpawnProtection, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                                </StackPanel>
                                            </WrapPanel>

                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Padding="24" Margin="0,0,0,16"
                                             Visibility="{Binding IsJavaSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel>
                                            <!-- Render & Simulation Distance Sliders -->
                                            <TextBlock Text="{loc:Tr 'World Simulation (Requires Restart)'}" Style="{StaticResource SettingsHeader}" FontSize="18" Margin="10,4,0,2"/>
                                            <TextBlock Text="{loc:Tr 'Controls how far (in chunks) players can see and how far the server actively simulates game mechanics.'}"
                                                       Style="{StaticResource SettingsSubtext}" Margin="10,0,0,12"/>
                                            <Grid Margin="10,0,10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Tr 'View Distance:'}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding World.ViewDistance, Mode=OneWay}"/><Run Text="{loc:Tr ' 区块'}"/>
                                                </TextBlock>
                                                <Slider Grid.Column="2" Value="{Binding World.ViewDistance}" Minimum="3" Maximum="32"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0"/>
                                                <TextBlock Grid.Column="3" Text="32" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                            <Grid Margin="10,0,10,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Tr 'Simulation Distance:'}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding World.SimulationDistance, Mode=OneWay}"/><Run Text="{loc:Tr ' 区块'}"/>
                                                </TextBlock>
                                                <Slider Grid.Column="2" Value="{Binding World.SimulationDistance}" Minimum="3" Maximum="32"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0"/>
                                                <TextBlock Grid.Column="3" Text="32" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Grid>

                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Padding="24" Margin="0,0,0,16"
                                             Visibility="{Binding IsJavaSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Features &amp; Security'}" Style="{StaticResource SettingsHeader}" FontSize="18" Margin="10,0,0,12"/>
                                            <WrapPanel>
                                                <StackPanel Width="400" Margin="10">
                                                    <ui:ToggleSwitch IsChecked="{Binding World.OnlineMode}" Content="{loc:Tr 'Online Mode (Identity Auth)'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding World.Pvp}" Content="{loc:Tr 'Enable PvP Damage'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding World.WhiteList}" Content="{loc:Tr 'Enable Whitelist'}" />
                                                </StackPanel>
                                                <StackPanel Width="400" Margin="10">
                                                    <ui:ToggleSwitch IsChecked="{Binding World.AllowCommandBlock}" Content="{loc:Tr 'Enable Command Blocks'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding World.AllowFlight}" Content="{loc:Tr 'Allow Cheat Flight'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding World.AllowNether}" Content="{loc:Tr 'Allow Dimension: Nether'}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Padding="24" Margin="0,0,0,16"
                                             Visibility="{Binding IsBedrockSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Core Rules'}" Style="{StaticResource SettingsHeader}" FontSize="18"/>
                                            <WrapPanel Margin="0,10,0,8">
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Default Gamemode:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ComboBox ItemsSource="{Binding World.Gamemodes}" SelectedItem="{Binding World.Gamemode, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Difficulty:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ComboBox ItemsSource="{Binding World.Difficulties}" SelectedItem="{Binding World.Difficulty, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Maximum Players:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ui:TextBox Text="{Binding World.MaxPlayers, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Tick Distance:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ui:TextBox Text="{Binding Bedrock.TickDistance, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'Default Permission:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ComboBox ItemsSource="{Binding Bedrock.PermissionLevels}" SelectedItem="{Binding Bedrock.DefaultPlayerPermissionLevel, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Width="280" Margin="10,0,10,20">
                                                    <TextBlock Text="{loc:Tr 'IPv6 Port:'}" Style="{StaticResource SettingsSubtext}"/>
                                                    <ui:TextBox Text="{Binding Bedrock.ServerPortV6, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
                                                </StackPanel>
                                            </WrapPanel>

                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Padding="24" Margin="0,0,0,16"
                                             Visibility="{Binding IsBedrockSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel>
                                            <!-- Bedrock Render Distance Slider -->
                                            <TextBlock Text="{loc:Tr 'World Simulation (Requires Restart)'}" Style="{StaticResource SettingsHeader}" FontSize="18" Margin="10,4,0,2"/>
                                            <TextBlock Text="{loc:Tr 'The maximum distance in chunks that the server will send world data to players. Higher values increase network and memory usage.'}"
                                                       Style="{StaticResource SettingsSubtext}" Margin="10,0,0,12" TextWrapping="Wrap"/>
                                            <Grid Margin="10,0,10,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Tr 'View Distance:'}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding Bedrock.ViewDistance, Mode=OneWay}"/><Run Text="{loc:Tr ' 区块'}"/>
                                                </TextBlock>
                                                <Slider Grid.Column="2" Value="{Binding Bedrock.ViewDistance}" Minimum="5" Maximum="96"
                                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0"/>
                                                <TextBlock Grid.Column="3" Text="96" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </Grid>

                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Padding="24" Margin="0,0,0,16"
                                             Visibility="{Binding IsBedrockSettings, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Features &amp; Security'}" Style="{StaticResource SettingsHeader}" FontSize="18" Margin="10,0,0,12"/>
                                            <WrapPanel>
                                                <StackPanel Width="400" Margin="10">
                                                    <ui:ToggleSwitch IsChecked="{Binding World.OnlineMode}" Content="{loc:Tr 'Online Mode'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding World.Pvp}" Content="{loc:Tr 'Enable PvP Damage'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding World.WhiteList}" Content="{loc:Tr 'Enable Whitelist'}" />
                                                </StackPanel>
                                                <StackPanel Width="400" Margin="10">
                                                    <ui:ToggleSwitch IsChecked="{Binding Bedrock.AllowCheats}" Content="{loc:Tr 'Allow Cheats'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding Bedrock.TexturepackRequired}" Content="{loc:Tr 'Require Resource Packs'}" />
                                                    <ui:ToggleSwitch IsChecked="{Binding Bedrock.ForceGamemode}" Content="{loc:Tr 'Force Default Gamemode'}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: WORLD & FILES -->
                        <TabItem Header="{loc:Tr 'World'}">
                            <ScrollViewer x:Name="WorldScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>
                                    <!-- 1. World Status CardControl -->
                                    <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon Folder24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Current World Status'}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding World.WorldSizeText}" Style="{StaticResource SettingsSubtext}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <TextBlock Text="{Binding World.WorldStatusText}" Foreground="#A6E3A1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    </ui:CardControl>

                                    <!-- 2. World Generation Settings -->
                                    <ui:Card Padding="24" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'World Generation'}" Style="{StaticResource SettingsHeader}" FontSize="18" Margin="0,0,0,16"/>
                                            <WrapPanel>
                                                <StackPanel Width="300" Margin="0,0,24,16">
                                                    <TextBlock Text="{loc:Tr 'World Generation Seed:'}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,8"/>
                                                    <ui:TextBox Text="{Binding World.Seed, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'Leave empty for random'}"/>
                                                </StackPanel>
                                                <StackPanel Width="300" Visibility="{Binding SupportsJavaWorldGenerator, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,16">
                                                    <TextBlock Text="{loc:Tr 'World Generator Type:'}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,8"/>
                                                    <ComboBox ItemsSource="{Binding World.LevelTypes}" SelectedItem="{Binding World.LevelType, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ui:Card>

                                    <!-- 3. File Management -->
                                    <ui:Card Padding="24" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'File Management'}" Style="{StaticResource SettingsHeader}" FontSize="18" Margin="0,0,0,4"/>
                                            <TextBlock Text="{loc:Tr 'Import a new map from the web or wipe your existing data to start fresh.'}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,16"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content="{Binding World.ImportWorldButtonText}" Command="{Binding World.UploadWorldCommand}" Appearance="Primary" Margin="0,0,12,0" Icon="{ui:SymbolIcon ArrowUpload24}"/>
                                                <ui:Button Content="{loc:Tr 'Browse Maps'}" Command="{Binding World.BrowseMapsCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon Globe24}" ToolTip="{loc:Tr 'Find community maps on minecraftmaps.com'}" Visibility="{Binding IsJavaSettings, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,12,0"/>
                                                <ui:Button Content="{loc:Tr 'Wipe World Data'}" Command="{Binding World.DeleteWorldCommand}" Appearance="Danger" Margin="0,0,0,0" Icon="{ui:SymbolIcon Delete24}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: ADDONS -->
                        <TabItem Header="{loc:Tr 'Addons'}">
                            <ScrollViewer x:Name="AddonsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>
                                    <!-- Auto-Update Addons moved to minimal toggle near Update All -->
                                    <!-- Search and Sort Control Bar -->
                                    <Grid Margin="4,0,4,16" Visibility="{Binding Addons.ShowVanillaWarning, Converter={StaticResource InvertedVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Search Box -->
                                        <ui:TextBox x:Name="AddonsSearchTextBox"
                                                    Text="{Binding Addons.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{Binding Addons.SearchPlaceholder}"
                                                    Icon="{ui:SymbolIcon Search20}"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"/>
                                        
                                        <!-- Sort Dropdown -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Tr 'Sort:'}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ComboBox Grid.Column="1" 
                                                      ItemsSource="{Binding Addons.SortOptions}" 
                                                      SelectedItem="{Binding Addons.SelectedSortOption}" 
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>



                                    <!-- Incompatible Addons Warning Banner -->
                                    <ui:Card Visibility="{Binding Addons.ShowIncompatibleWarning, Converter={StaticResource VisibleIfTrue}}"
                                             Margin="4,0,4,16" Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Warning Icon -->
                                            <ui:SymbolIcon Grid.Row="0" Grid.Column="0" Symbol="Warning24" Foreground="#F9E2AF" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"/>

                                            <!-- Title & Message -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Tr 'Incompatible Add-ons Detected'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Addons.IncompatibleWarningMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Action Buttons (Yes / No) -->
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <ui:Button Content="{loc:Tr 'Remove Incompatible'}"
                                                           Appearance="Primary"
                                                           Command="{Binding Addons.RemoveIncompatibleAddonsCommand}"
                                                           Margin="0,0,8,0"
                                                           ToolTip="{loc:Tr 'Automatically delete all incompatible add-ons from disk'}"/>
                                                <ui:Button Content="{loc:Tr 'Keep'}"
                                                           Appearance="Secondary"
                                                           Command="{Binding Addons.DismissIncompatibleWarningCommand}"
                                                           ToolTip="{loc:Tr 'Keep incompatible add-ons and dismiss this notification'}"/>
                                            </StackPanel>

                                            <!-- Don't ask again CheckBox -->
                                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                      Content="{loc:Tr &quot;Don't ask again&quot;}"
                                                      IsChecked="{Binding Addons.DontAskAgainIncompatible, Mode=TwoWay}"
                                                      FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Grid>
                                    </ui:Card>

                                    <ui:Card Visibility="{Binding Addons.ShowServerRunningAddonMessage, Converter={StaticResource VisibleIfTrue}}"
                                             Background="#2A2535" BorderBrush="#CBA6F7" BorderThickness="1"
                                             Margin="4,0,4,16" Padding="12">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Info24" Foreground="#CBA6F7" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Addons.ServerRunningAddonMessage}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#CBA6F7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ui:Card>

                                    <!-- Vanilla Empty State -->
                                    <ui:Card Padding="32" Margin="0,0,0,16"
                                             Visibility="{Binding Addons.ShowVanillaWarning, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Prohibited24" FontSize="36" Foreground="#F38BA8" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="{loc:Tr &quot;Vanilla doesn't support mods, plugins, and addons.&quot;}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{loc:Tr 'To install plugins or mods, please change your server type to Paper, Fabric, Forge, or NeoForge.'}"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,6,0,0" MaxWidth="360"/>
                                        </StackPanel>
                                    </ui:Card>

                                    <!-- Server Plugins Section -->
                                    <StackPanel Visibility="{Binding Addons.SupportsPlugins, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,24">
                                        <TextBlock Text="{loc:Tr 'Server Plugins'}" Style="{StaticResource SettingsHeader}" Margin="4,0,0,12"/>
                                        <ui:Card Margin="0,0,0,16" Padding="20">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding Addons.IsPocketmine, Converter={StaticResource VisibleIfTrue}}">
                                                    <ui:SymbolIcon Symbol="Info24" FontSize="12" Foreground="#89B4FA" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{loc:Tr 'PocketMine plugins are .phar files. Use the Add Plugin button to install them.'}" Foreground="#89B4FA" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:Button Content="{loc:Tr 'Local File'}" Command="{Binding Addons.AddPluginCommand}" Appearance="Secondary" Margin="0,0,12,0" Icon="{ui:SymbolIcon Add20}"/>
                                                        <ui:Button Content="{loc:Tr 'Plugin Marketplace'}" Command="{Binding Addons.BrowseModrinthPluginsCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Globe20}"
                                                                   Visibility="{Binding Addons.IsPocketmine, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding Addons.IsPocketmine, Converter={StaticResource InvertedVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Tr 'Auto-Update'}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <ui:ToggleSwitch IsChecked="{Binding Addons.AutoUpdateAddons, Mode=TwoWay}" 
                                                                         Margin="0,0,12,0" 
                                                                         ToolTip="{loc:Tr 'Automatically update on server start'}"
                                                                         Visibility="{Binding Addons.SupportsModrinth, Converter={StaticResource VisibleIfTrue}}"/>
                                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0">
                                                            <ui:ProgressRing.Style>
                                                                <Style TargetType="ui:ProgressRing">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Addons.IsUpdatingAll}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:ProgressRing.Style>
                                                        </ui:ProgressRing>
                                                        <ui:Button Content="{loc:Tr 'Update All'}" Style="{StaticResource AiActionButtonStyle}"
                                                                   Command="{Binding Addons.UpdateAllPluginsCommand}"
                                                                   Icon="{ui:SymbolIcon ArrowSync20}"
                                                                   Cursor="Hand"
                                                                   ToolTip="{loc:Tr 'Check all installed plugins for updates'}"/>
                                                    </StackPanel>
                                                </Grid>

                                            </StackPanel>
                                        </ui:Card>
                                        <!-- Plugins Skeleton Loader -->
                                        <StackPanel Visibility="{Binding Addons.IsLoading, Converter={StaticResource VisibleIfTrue}}">
                                            <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,10" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="6" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource SkeletonElement}" Height="16" Width="180" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                        <Border Style="{StaticResource SkeletonElement}" Height="12" Width="240" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="30" CornerRadius="6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,10" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="6" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource SkeletonElement}" Height="16" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                        <Border Style="{StaticResource SkeletonElement}" Height="12" Width="200" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="30" CornerRadius="6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Addons.Plugins}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Addons.IsLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card Margin="0,0,0,10" Padding="16,12" Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                        <ui:Card.ContextMenu>
                                                            <ContextMenu Opened="AddonContextMenu_Opened">
                                                                <MenuItem Header="{Binding ToggleActionLabel}"
                                                                          Command="{Binding Path=PlacementTarget.Tag.ToggleModActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Power20"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{loc:Tr 'Check for Updates'}"
                                                                          Command="{Binding Path=PlacementTarget.Tag.UpdatePluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="ArrowSync20"/>
                                                                    </MenuItem.Icon>
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                            <Setter Property="IsEnabled" Value="True"/>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                          Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                          Command="{Binding Path=PlacementTarget.Tag.DeletePluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </ui:Card.ContextMenu>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Icon -->
                                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="{DynamicResource ControlAltFillColorTertiaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            
                                                            <!-- Info -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                    <Border Visibility="{Binding IsDisabled, Converter={StaticResource VisibleIfTrue}}"
                                                                            Background="#4F4F4F" CornerRadius="4" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{loc:Tr 'Disabled'}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                
                                                                <!-- Subtitle: Loader · Version · Source · Side -->
                                                                <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding LoaderType}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasVersion, Converter={StaticResource VisibleIfTrue}}">
                                                                        <TextBlock Text="{loc:Tr 'v'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                    </StackPanel>
                                                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                            Visibility="{Binding ShowIncompatibleBadge, Converter={StaticResource VisibleIfTrue}}"
                                                                            ToolTip="{Binding IncompatibleToolTip}"
                                                                            Cursor="Help">
                                                                        <ui:SymbolIcon Symbol="Warning12" Foreground="#F9E2AF" FontSize="11" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </WrapPanel>


                                                            </StackPanel>
                                                            
                                                            <!-- Action buttons -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0">
                                                                    <ui:ProgressRing.Style>
                                                                        <Style TargetType="ui:ProgressRing">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:ProgressRing.Style>
                                                                </ui:ProgressRing>
                                                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                                 Command="{Binding DataContext.Addons.ToggleModActiveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                 CommandParameter="{Binding}"
                                                                                 IsEnabled="{Binding CanToggle}"
                                                                                 ToolTip="{Binding ToggleToolTip}"
                                                                                 OnContent="" OffContent="" Content=""
                                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <ui:Button Appearance="Secondary" VerticalAlignment="Center"
                                                                           Icon="{ui:SymbolIcon MoreVertical20}"
                                                                           ToolTip="{loc:Tr 'More options'}"
                                                                           Click="BtnAddonMoreOptions_Click"
                                                                           Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                                    <ui:Button.ContextMenu>
                                                                        <ContextMenu Opened="AddonContextMenu_Opened">
                                                                            <MenuItem Header="{loc:Tr 'Check for Updates'}"
                                                                                      Command="{Binding Path=PlacementTarget.Tag.UpdatePluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}">
                                                                                <MenuItem.Icon>
                                                                                    <ui:SymbolIcon Symbol="ArrowSync20"/>
                                                                                </MenuItem.Icon>
                                                                                <MenuItem.Style>
                                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </MenuItem.Style>
                                                                            </MenuItem>
                                                                            <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                                      Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}">
                                                                                <MenuItem.Icon>
                                                                                    <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <Separator/>
                                                                            <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                                      Command="{Binding Path=PlacementTarget.Tag.DeletePluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}">
                                                                                <MenuItem.Icon>
                                                                                    <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                        </ContextMenu>
                                                                    </ui:Button.ContextMenu>
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Plugins Empty State -->
                                        <Grid Margin="0,0,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Addons.Plugins.Count}" Value="0"/>
                                                                <Condition Binding="{Binding Addons.IsLoading}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <ui:Card Padding="32" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Cube24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                    <TextBlock Text="{loc:Tr 'No plugins installed'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{loc:Tr &quot;Click 'Plugin Marketplace' to discover and install new plugins.&quot;}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="{Binding Addons.IsPocketmine, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                </StackPanel>
                                            </ui:Card>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Server Mods Section -->
                                    <StackPanel Visibility="{Binding Addons.SupportsMods, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,24">
                                        <TextBlock Text="{loc:Tr 'Server Mods'}" Style="{StaticResource SettingsHeader}" Margin="4,0,0,12"/>
                                        <ui:Card Margin="0,0,0,16" Padding="20">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:Button Content="{loc:Tr 'Add Mod JAR'}" Command="{Binding Addons.AddModCommand}" Appearance="Secondary" Margin="0,0,12,0" Icon="{ui:SymbolIcon Add20}"/>
                                                        <ui:Button Content="{loc:Tr 'Browse Marketplace'}" Command="{Binding Addons.BrowseModrinthModsCommand}" Appearance="Primary" Margin="0,0,12,0" Icon="{ui:SymbolIcon Globe20}"
                                                                   Visibility="{Binding Addons.SupportsModrinth, Converter={StaticResource VisibleIfTrue}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Tr 'Auto-Update'}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <ui:ToggleSwitch IsChecked="{Binding Addons.AutoUpdateAddons, Mode=TwoWay}" 
                                                                         Margin="0,0,12,0" 
                                                                         ToolTip="{loc:Tr 'Automatically update on server start'}"
                                                                         Visibility="{Binding Addons.SupportsModrinth, Converter={StaticResource VisibleIfTrue}}"/>
                                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0">
                                                            <ui:ProgressRing.Style>
                                                                <Style TargetType="ui:ProgressRing">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Addons.IsUpdatingAll}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:ProgressRing.Style>
                                                        </ui:ProgressRing>
                                                        <ui:Button Content="{loc:Tr 'Update All'}" Style="{StaticResource AiActionButtonStyle}"
                                                                   Command="{Binding Addons.UpdateAllModsCommand}"
                                                                   Icon="{ui:SymbolIcon ArrowSync20}"
                                                                   Cursor="Hand"
                                                                   ToolTip="{loc:Tr 'Check all installed mods for updates'}"
                                                                   Visibility="{Binding Addons.SupportsModrinth, Converter={StaticResource VisibleIfTrue}}"/>
                                                    </StackPanel>
                                                </Grid>

                                            </StackPanel>
                                        </ui:Card>
                                        <!-- Mods Skeleton Loader -->
                                        <StackPanel Visibility="{Binding Addons.IsLoading, Converter={StaticResource VisibleIfTrue}}">
                                            <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,10" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="6" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource SkeletonElement}" Height="16" Width="180" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                        <Border Style="{StaticResource SkeletonElement}" Height="12" Width="240" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="30" CornerRadius="6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,10" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="6" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource SkeletonElement}" Height="16" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                                        <Border Style="{StaticResource SkeletonElement}" Height="12" Width="200" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="30" CornerRadius="6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Addons.Mods}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Addons.IsLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card Margin="0,0,0,10" Padding="16,12" Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                        <ui:Card.ContextMenu>
                                                            <ContextMenu Opened="AddonContextMenu_Opened">
                                                                <MenuItem Command="{Binding Path=PlacementTarget.Tag.ToggleModActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="Disable Mod"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                    <Setter Property="Header" Value="Enable Mod"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Power20"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{loc:Tr 'Check for Updates'}"
                                                                          Command="{Binding Path=PlacementTarget.Tag.UpdateModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="ArrowSync20"/>
                                                                    </MenuItem.Icon>
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                            <Setter Property="IsEnabled" Value="True"/>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PlacementTarget.Tag.SupportsModrinth, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                          Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                          Command="{Binding Path=PlacementTarget.Tag.DeleteModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </ui:Card.ContextMenu>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon -->
                                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="{DynamicResource ControlAltFillColorTertiaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>

                                                            <!-- Info -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                    
                                                                    <!-- Disabled badge -->
                                                                    <Border Visibility="{Binding IsDisabled, Converter={StaticResource VisibleIfTrue}}"
                                                                            Background="#4F4F4F" CornerRadius="4" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{loc:Tr 'Disabled'}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Subtitle: Filename · Loader · Version · Source -->
                                                                <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">

                                                                    
                                                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding LoaderType}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                    </Border>
                                                                    
                                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasVersion, Converter={StaticResource VisibleIfTrue}}">
                                                                        <TextBlock Text="{loc:Tr 'v'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                    </StackPanel>
                                                                    
                                                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                    </Border>

                                                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                            Visibility="{Binding ShowIncompatibleBadge, Converter={StaticResource VisibleIfTrue}}"
                                                                            ToolTip="{Binding IncompatibleToolTip}"
                                                                            Cursor="Help">
                                                                        <ui:SymbolIcon Symbol="Warning12" Foreground="#F9E2AF" FontSize="11" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </WrapPanel>


                                                            </StackPanel>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0">
                                                                    <ui:ProgressRing.Style>
                                                                        <Style TargetType="ui:ProgressRing">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:ProgressRing.Style>
                                                                </ui:ProgressRing>
                                                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                                 Command="{Binding DataContext.Addons.ToggleModActiveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                 CommandParameter="{Binding}"
                                                                                 IsEnabled="{Binding CanToggle}"
                                                                                 ToolTip="{Binding ToggleToolTip}"
                                                                                 OnContent="" OffContent="" Content=""
                                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <ui:Button Appearance="Secondary" VerticalAlignment="Center"
                                                                           Icon="{ui:SymbolIcon MoreVertical20}"
                                                                           ToolTip="{loc:Tr 'More options'}"
                                                                           Click="BtnAddonMoreOptions_Click"
                                                                           Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                                    <ui:Button.ContextMenu>
                                                                        <ContextMenu Opened="AddonContextMenu_Opened">
                                                                            <MenuItem Header="{loc:Tr 'Check for Updates'}"
                                                                                      Command="{Binding Path=PlacementTarget.Tag.UpdateModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}">
                                                                                <MenuItem.Icon>
                                                                                    <ui:SymbolIcon Symbol="ArrowSync20"/>
                                                                                </MenuItem.Icon>
                                                                                <MenuItem.Style>
                                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding PlacementTarget.Tag.SupportsModrinth, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </MenuItem.Style>
                                                                            </MenuItem>
                                                                            <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                                      Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}">
                                                                                <MenuItem.Icon>
                                                                                    <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                            <Separator/>
                                                                            <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                                      Command="{Binding Path=PlacementTarget.Tag.DeleteModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding}">
                                                                                <MenuItem.Icon>
                                                                                    <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                                </MenuItem.Icon>
                                                                            </MenuItem>
                                                                        </ContextMenu>
                                                                    </ui:Button.ContextMenu>
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Mods Empty State -->
                                        <Grid Margin="0,0,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Addons.Mods.Count}" Value="0"/>
                                                                <Condition Binding="{Binding Addons.IsLoading}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <ui:Card Padding="32" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Cube24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                    <TextBlock Text="{loc:Tr 'No mods installed'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{loc:Tr &quot;Click 'Browse Marketplace' to discover and install new mods.&quot;}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </ui:Card>
                                        </Grid>
                                    </StackPanel>

                                    <!-- BDS: Add-on & Pack Management Section -->
                                    <StackPanel Visibility="{Binding Addons.SupportsBedrockAddons, Converter={StaticResource VisibleIfTrue}}">
                                        <!-- Clean Segmented Switcher & Action Toolbar -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Segmented Switcher: Behavior vs Resource Packs -->
                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="{loc:Tr 'Behavior Packs'}"
                                                                 IsChecked="{Binding Addons.IsBehaviorPacksTabSelected, Mode=TwoWay}"
                                                                 GroupName="BedrockPacksTabs"
                                                                 Style="{StaticResource {x:Type ToggleButton}}"
                                                                 Padding="16,7"
                                                                 FontSize="13"
                                                                 FontWeight="SemiBold"/>
                                                    <RadioButton Content="{loc:Tr 'Resource Packs'}"
                                                                 IsChecked="{Binding Addons.IsResourcePacksTabSelected, Mode=TwoWay}"
                                                                 GroupName="BedrockPacksTabs"
                                                                 Style="{StaticResource {x:Type ToggleButton}}"
                                                                 Padding="16,7"
                                                                 FontSize="13"
                                                                 FontWeight="SemiBold"
                                                                 Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right-side Action Toolbar -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="{loc:Tr 'Import Add-on'}" Appearance="Primary" Icon="{ui:SymbolIcon Add20}"
                                                           Command="{Binding Addons.ImportBedrockAddonCommand}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- TAB 1: BEHAVIOR PACKS LIST -->
                                        <StackPanel Visibility="{Binding Addons.IsBehaviorPacksTabSelected, Converter={StaticResource VisibleIfTrue}}">
                                            <!-- Behavior Packs Skeleton Loader -->
                                            <StackPanel Visibility="{Binding Addons.IsLoading, Converter={StaticResource VisibleIfTrue}}">
                                                <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,8" Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"/>
                                                        <Border Grid.Column="1" Style="{StaticResource SkeletonElement}" Height="16" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="28" CornerRadius="6" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,8" Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"/>
                                                        <Border Grid.Column="1" Style="{StaticResource SkeletonElement}" Height="16" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="28" CornerRadius="6" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Addons.BehaviorPacks}" Margin="0,0,0,8">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Addons.IsLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ui:Card Margin="0,0,0,8" Padding="14,10" Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                            <ui:Card.ContextMenu>
                                                                <ContextMenu Opened="AddonContextMenu_Opened">
                                                                    <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                              Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                              Command="{Binding Path=PlacementTarget.Tag.DeleteBedrockAddonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </ui:Card.ContextMenu>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Pack Icon -->
                                                                <Border Width="40" Height="40" CornerRadius="8" Background="#1E1E2E" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <ui:SymbolIcon Symbol="Cube24" FontSize="20" Foreground="#CBA6F7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding Icon, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Info Column -->
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Actions -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Priority Reordering -->
                                                                    <ui:Button Appearance="Secondary" Margin="0,0,4,0" VerticalAlignment="Center" Padding="6,5"
                                                                               Command="{Binding DataContext.Addons.MoveBedrockPackUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                               CommandParameter="{Binding}"
                                                                               IsEnabled="{Binding IsEnabled}"
                                                                               Icon="{ui:SymbolIcon ArrowUp20}"
                                                                               ToolTip="{loc:Tr 'Increase Priority (Load Earlier)'}"/>
                                                                    <ui:Button Appearance="Secondary" Margin="0,0,8,0" VerticalAlignment="Center" Padding="6,5"
                                                                               Command="{Binding DataContext.Addons.MoveBedrockPackDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                               CommandParameter="{Binding}"
                                                                               IsEnabled="{Binding IsEnabled}"
                                                                               Icon="{ui:SymbolIcon ArrowDown20}"
                                                                               ToolTip="{loc:Tr 'Decrease Priority (Load Later)'}"/>

                                                                    <!-- Enable / Disable Toggle -->
                                                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                                     Command="{Binding DataContext.Addons.ToggleBedrockPackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                     CommandParameter="{Binding}"
                                                                                     OnContent="Active" OffContent="Inactive" Content=""
                                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                    <!-- Options Menu -->
                                                                    <ui:Button Appearance="Secondary" VerticalAlignment="Center" Padding="6,5"
                                                                               Icon="{ui:SymbolIcon MoreVertical20}"
                                                                               ToolTip="{loc:Tr 'More options'}"
                                                                               Click="BtnAddonMoreOptions_Click"
                                                                               Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                                        <ui:Button.ContextMenu>
                                                                            <ContextMenu Opened="AddonContextMenu_Opened">
                                                                                <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                                          Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                          CommandParameter="{Binding}">
                                                                                    <MenuItem.Icon>
                                                                                        <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <Separator/>
                                                                                <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                                          Command="{Binding Path=PlacementTarget.Tag.DeleteBedrockAddonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                          CommandParameter="{Binding}">
                                                                                    <MenuItem.Icon>
                                                                                        <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </ui:Button.ContextMenu>
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ui:Card>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Behavior Packs Empty State -->
                                            <Grid Margin="0,0,0,24">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Addons.BehaviorPacks.Count}" Value="0"/>
                                                                    <Condition Binding="{Binding Addons.IsLoading}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ui:Card Padding="24" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{loc:Tr 'No Behavior Packs Installed'}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{loc:Tr 'Import .mcpack or .mcaddon files to add custom entities, loot, and gameplay features.'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </ui:Card>
                                            </Grid>
                                        </StackPanel>

                                        <!-- TAB 2: RESOURCE PACKS LIST -->
                                        <StackPanel Visibility="{Binding Addons.IsResourcePacksTabSelected, Converter={StaticResource VisibleIfTrue}}">
                                            <!-- Require Resource Packs Option Card -->
                                            <ui:Card Margin="0,0,0,12" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Tr 'Require Players to Accept Resource Packs'}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{loc:Tr 'Forces connecting Minecraft players to download and accept server texture packs before joining (texturepack-required).'}"
                                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="1"
                                                                     IsChecked="{Binding Addons.TexturepackRequired, Mode=TwoWay}"
                                                                     OnContent="Required" OffContent="Optional" Content=""
                                                                     VerticalAlignment="Center"/>
                                                </Grid>
                                            </ui:Card>

                                            <!-- Resource Packs Skeleton Loader -->
                                            <StackPanel Visibility="{Binding Addons.IsLoading, Converter={StaticResource VisibleIfTrue}}">
                                                <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,8" Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"/>
                                                        <Border Grid.Column="1" Style="{StaticResource SkeletonElement}" Height="16" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="28" CornerRadius="6" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,8" Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"/>
                                                        <Border Grid.Column="1" Style="{StaticResource SkeletonElement}" Height="16" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="120" Height="28" CornerRadius="6" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Addons.ResourcePacks}" Margin="0,0,0,8">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Addons.IsLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ui:Card Margin="0,0,0,8" Padding="14,10" Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                            <ui:Card.ContextMenu>
                                                                <ContextMenu Opened="AddonContextMenu_Opened">
                                                                    <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                              Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                              Command="{Binding Path=PlacementTarget.Tag.DeleteBedrockAddonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </ui:Card.ContextMenu>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Pack Icon -->
                                                                <Border Width="40" Height="40" CornerRadius="8" Background="#1E1E2E" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <ui:SymbolIcon Symbol="Color24" FontSize="20" Foreground="#89B4FA" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding Icon, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Info Column -->
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Actions -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Priority Reordering -->
                                                                    <ui:Button Appearance="Secondary" Margin="0,0,4,0" VerticalAlignment="Center" Padding="6,5"
                                                                               Command="{Binding DataContext.Addons.MoveBedrockPackUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                               CommandParameter="{Binding}"
                                                                               IsEnabled="{Binding IsEnabled}"
                                                                               Icon="{ui:SymbolIcon ArrowUp20}"
                                                                               ToolTip="{loc:Tr 'Increase Priority (Load Earlier)'}"/>
                                                                    <ui:Button Appearance="Secondary" Margin="0,0,8,0" VerticalAlignment="Center" Padding="6,5"
                                                                               Command="{Binding DataContext.Addons.MoveBedrockPackDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                               CommandParameter="{Binding}"
                                                                               IsEnabled="{Binding IsEnabled}"
                                                                               Icon="{ui:SymbolIcon ArrowDown20}"
                                                                               ToolTip="{loc:Tr 'Decrease Priority (Load Later)'}"/>

                                                                    <!-- Enable / Disable Toggle -->
                                                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                                     Command="{Binding DataContext.Addons.ToggleBedrockPackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                     CommandParameter="{Binding}"
                                                                                     OnContent="Active" OffContent="Inactive" Content=""
                                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                    <!-- Options Menu -->
                                                                    <ui:Button Appearance="Secondary" VerticalAlignment="Center" Padding="6,5"
                                                                               Icon="{ui:SymbolIcon MoreVertical20}"
                                                                               ToolTip="{loc:Tr 'More options'}"
                                                                               Click="BtnAddonMoreOptions_Click"
                                                                               Tag="{Binding DataContext.Addons, RelativeSource={RelativeSource AncestorType=Page}}">
                                                                        <ui:Button.ContextMenu>
                                                                            <ContextMenu Opened="AddonContextMenu_Opened">
                                                                                <MenuItem Header="{loc:Tr 'Open Folder'}" 
                                                                                          Command="{Binding Path=PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                          CommandParameter="{Binding}">
                                                                                    <MenuItem.Icon>
                                                                                        <ui:SymbolIcon Symbol="FolderOpen20"/>
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <Separator/>
                                                                                <MenuItem Header="{loc:Tr 'Delete'}" 
                                                                                          Command="{Binding Path=PlacementTarget.Tag.DeleteBedrockAddonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                          CommandParameter="{Binding}">
                                                                                    <MenuItem.Icon>
                                                                                        <ui:SymbolIcon Symbol="Delete20" Foreground="#F38BA8"/>
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </ui:Button.ContextMenu>
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ui:Card>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Resource Packs Empty State -->
                                            <Grid Margin="0,0,0,24">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Addons.ResourcePacks.Count}" Value="0"/>
                                                                    <Condition Binding="{Binding Addons.IsLoading}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ui:Card Padding="24" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Color24" FontSize="28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{loc:Tr 'No Resource Packs Installed'}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{loc:Tr 'Import .mcpack or .mcaddon files to stream custom textures, models, and audio to connecting players.'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </ui:Card>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 5: BACKUPS -->
                        <TabItem Header="{loc:Tr 'Backups'}">
                            <ScrollViewer x:Name="BackupsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>

                                    <!-- HEALTH WARNINGS BANNER -->
                                    <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="8"
                                            Visibility="{Binding Backups.HasHealthWarning, Converter={StaticResource VisibleIfTrue}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#22F9A825"/>
                                                <Setter Property="BorderBrush" Value="#44F9A825"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Backups.HasHealthCritical}" Value="True">
                                                        <Setter Property="Background" Value="#22F38BA8"/>
                                                        <Setter Property="BorderBrush" Value="#44F38BA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Warning24"/>
                                                        <Setter Property="Foreground" Value="#F9A825"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Backups.HasHealthCritical}" Value="True">
                                                                <Setter Property="Symbol" Value="ErrorCircle24"/>
                                                                <Setter Property="Foreground" Value="#F38BA8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{loc:Tr Backup Health Warning}"/>
                                                            <Setter Property="Foreground" Value="#F9A825"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Backups.HasHealthCritical}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F38BA8"/>
                                                                    <Setter Property="Text" Value="{loc:Tr Backup Health Alert}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Backups.HealthWarningText}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- BACKUP STATS SUMMARY -->
                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <UniformGrid Columns="3">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Tr 'TOTAL SIZE'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Backups.TotalBackupsSizeText, FallbackValue='—'}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Tr 'LAST BACKUP'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Backups.LastBackupTimeText, FallbackValue='Never'}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Tr 'DISK SPACE'}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Backups.DiskSpaceText, FallbackValue='—'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Backups.ShowDiskWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F38BA8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- LOCAL BACKUP LOCATION & MANUAL BACKUP -->
                                    <ui:Card Padding="16,12" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Location config -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{loc:Tr 'Local Storage Destination'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0" Text="{Binding Backups.CustomBackupDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'Default: [Server Folder]\backups'}" IsReadOnly="True" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <ui:Button Content="{loc:Tr 'Browse'}" Command="{Binding Backups.BrowseBackupDirCommand}" Margin="0,0,8,0"/>
                                                        <ui:Button Content="{loc:Tr 'Reset'}" Command="{Binding Backups.ResetBackupDirCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Manual Action -->
                                            <Border Grid.Column="1" VerticalAlignment="Center" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Tr 'Manual Action'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                    <ui:Button Content="{loc:Tr 'Create Backup Now'}" Command="{Binding Backups.CreateBackupCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Save20}"/>
                                                    <TextBlock Text="{Binding Backups.BackupStatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="{Binding Backups.IsBackingUp, Converter={StaticResource VisibleIfTrue}}"/>
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Backups.BackupProgressValue}" IsIndeterminate="{Binding Backups.IsBackupProgressIndeterminate}" Height="2" Margin="0,2,0,0" Visibility="{Binding Backups.IsBackingUp, Converter={StaticResource VisibleIfTrue}}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ui:Card>

                                    <!-- AUTOMATED DATA RETENTION CONFIG -->
                                    <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon Timer24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Automated Data Retention'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Backup interval and maximum archives to keep'}" Style="{StaticResource SettingsSubtext}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Tr 'Interval (Hours):'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBox Text="{Binding Backups.BackupIntervalHours, Mode=TwoWay}" Width="80" ClearButtonEnabled="False" PlaceholderText="0" Margin="0,0,16,0"/>
                                            <TextBlock Text="{loc:Tr 'Keep limit:'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBox Text="{Binding Backups.MaxBackupsToKeep, Mode=TwoWay}" Width="80" ClearButtonEnabled="False"/>
                                        </StackPanel>
                                    </ui:CardControl>

                                    <ui:Card Padding="16,12" Margin="0,0,0,16"
                                             Visibility="{Binding CloudBackups.IsCloudBackupsEnabled, Converter={StaticResource VisibleIfTrue}}">
                                        <StackPanel DataContext="{Binding CloudBackups}">
                                            <TextBlock Text="{loc:Tr 'Cloud Off-site Sync'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{loc:Tr 'Enable cloud retention. Requires a connected provider in App Settings.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>

                                            <StackPanel Visibility="{Binding IsRefreshingProviders, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,12">
                                                <ProgressBar IsIndeterminate="True" Height="2"/>
                                                <TextBlock Text="{Binding ProviderStatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowNoConnectedProvidersMessage, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding ProviderStatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding HasConnectedProviders, Converter={StaticResource VisibleIfTrue}}">
                                                <ItemsControl ItemsSource="{Binding Targets}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,24,12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ui:ToggleSwitch Grid.Column="0" Content="{Binding ProviderType}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsEnabled, Converter={StaticResource VisibleIfTrue}}">
                                                                    <TextBlock Text="{loc:Tr 'Retention:'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    <ui:TextBox Text="{Binding RetentionCount, Mode=TwoWay}" Width="70" VerticalAlignment="Center" ClearButtonEnabled="False"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Separator Margin="0,8" Opacity="0.15"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Tr 'Remote Backups'}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ui:Button Grid.Column="1" Content="{loc:Tr 'Refresh'}" Command="{Binding RefreshRemoteBackupsCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync20}" VerticalAlignment="Center" Padding="8,4"/>
                                                </Grid>

                                                <ScrollViewer Margin="0,12,0,0" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding RemoteBackups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ui:Card Margin="0,0,0,8" Padding="12,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ui:SymbolIcon Symbol="Cloud20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13"/>
                                                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                                <Run Text="{Binding Provider, StringFormat={}[{0}] }"/>
                                                                                <Run Text="{Binding SizeMb, StringFormat={}{0:F1} MB}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <ui:Button Content="{loc:Tr 'Restore'}" Appearance="Secondary" Command="{Binding DataContext.RestoreRemoteBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                                                            <ui:Button Icon="{ui:SymbolIcon Delete20}" Appearance="Danger" Command="{Binding DataContext.DeleteRemoteBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </ui:Card>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Card>

                                    <!-- BACKUP HISTORY (Versioned Cards) -->
                                    <TextBlock Text="{loc:Tr 'Backup History'}" Style="{StaticResource SettingsHeader}" Margin="4,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Backups.BackupList}" Margin="0,0,0,24">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="0,0,0,10" Padding="16,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Version Badge -->
                                                        <Border Grid.Column="0" Background="#3389B4FA" CornerRadius="6" Padding="8,4" Margin="0,0,12,0"
                                                                VerticalAlignment="Top" HorizontalAlignment="Center" MinWidth="36">
                                                            <TextBlock Text="{Binding VersionText, FallbackValue='—'}" FontSize="12" FontWeight="Bold"
                                                                       Foreground="{DynamicResource SystemFillColorAttentionBrush}" HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Backup Info -->
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                        Visibility="{Binding HasMetadata, Converter={StaticResource VisibleIfTrue}}">
                                                                    <TextBlock Text="{Binding TriggerText}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                </Border>
                                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" ToolTip="{Binding FullPath}">
                                                                    <TextBlock Text="{Binding LocationText}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding SizeDeltaText}" FontSize="11" Foreground="#A6E3A1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0"/>
                                                                <TextBlock Text="{Binding CreatedAtText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                                        Visibility="{Binding HasMetadata, Converter={StaticResource VisibleIfTrue}}">
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding ServerType, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding ServerVersion, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <!-- Label Editor -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                                        Visibility="{Binding HasMetadata, Converter={StaticResource VisibleIfTrue}}">
                                                                <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Tr 'Add a label...'}"
                                                                            MinHeight="30" FontSize="12" Width="280" Margin="0,0,8,0"/>
                                                                <ui:Button Icon="{ui:SymbolIcon Save16}" Appearance="Transparent" Padding="4"
                                                                           Command="{Binding DataContext.Backups.SaveLabelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                           CommandParameter="{Binding}" ToolTip="{loc:Tr 'Save label'}"/>
                                                            </StackPanel>

                                                            <!-- Integrity Status -->
                                                            <TextBlock Text="{Binding IntegrityStatusText}" FontSize="11" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Action Buttons -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <ui:Button Icon="{ui:SymbolIcon ShieldCheckmark20}" Appearance="Transparent" Padding="6"
                                                                       Command="{Binding DataContext.Backups.VerifyIntegrityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding}" ToolTip="{loc:Tr 'Verify integrity'}" Margin="0,0,4,0"/>
                                                            <ui:Button Content="{loc:Tr 'Restore'}" Appearance="Secondary"
                                                                       Command="{Binding DataContext.Backups.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding FullPath}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <ui:Button Icon="{ui:SymbolIcon Delete20}" Appearance="Danger"
                                                                       Command="{Binding DataContext.Backups.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                       CommandParameter="{Binding FullPath}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Backups Empty State -->
                                    <Grid Margin="0,-8,0,24">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Backups.BackupList.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <ui:Card Padding="32" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="FolderZip24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="{loc:Tr 'No backups found'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{loc:Tr &quot;Click 'Create Backup Now' or enable automated backups to protect your server data.&quot;}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:Card>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 6: RESTART & RECOVERY -->
                        <TabItem Header="{loc:Tr 'RestartAndRecovery'}">
                            <ScrollViewer x:Name="RestartScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'Crash Recovery'}" Style="{StaticResource SettingsHeader}" Margin="0,0,0,8"/>

                                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowSync24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Auto-Restart Engine'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Automatically restart the server if it crashes unexpectedly.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Advanced.EnableAutoRestart}" VerticalAlignment="Center"/>
                                    </ui:CardControl>

                                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Warning24}" IsEnabled="{Binding Advanced.EnableAutoRestart}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Failure Tolerance'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Maximum number of consecutive crash restarts before giving up.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Tr 'Attempts:'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBox Text="{Binding Advanced.MaxAutoRestarts}" Width="80" ClearButtonEnabled="False" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:CardControl>

                                    <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon Timer24}" IsEnabled="{Binding Advanced.EnableAutoRestart}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Restart Cooldown'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Delay between crash and restart to allow resources to release.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Tr 'Seconds:'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBox Text="{Binding Advanced.AutoRestartDelay}" Width="80" ClearButtonEnabled="False" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:CardControl>

                                    <!-- Scheduled Maintenance -->
                                    <TextBlock Text="{loc:Tr 'Scheduled Maintenance'}" Style="{StaticResource SettingsHeader}" Margin="0,8,0,8"/>

                                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowClockwise24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Scheduled Reboot'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Periodically reboot the server to clear memory leaks and maintain peak responsiveness.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Advanced.EnableScheduledReboot}" VerticalAlignment="Center"/>
                                    </ui:CardControl>

                                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Timer24}" IsEnabled="{Binding Advanced.EnableScheduledReboot}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Reboot Frequency'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Configure whether the server reboots at a fixed daily time (24-hour format) or after a recurring interval.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox ItemsSource="{Binding Advanced.RebootModes}"
                                                      SelectedItem="{Binding Advanced.ScheduledRebootMode, Mode=TwoWay}"
                                                      Width="110" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding Advanced.IsDailyMode, Converter={StaticResource VisibleIfTrue}}">
                                                <TextBlock Text="{loc:Tr 'Time (24h):'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBox Text="{Binding Advanced.ScheduledRebootTime}" Width="110" ClearButtonEnabled="False" PlaceholderText="{loc:Tr '04:00 (24h)'}" ToolTip="{loc:Tr '24-hour time format (00:00 - 23:59), e.g. 04:00 or 16:30'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding Advanced.IsIntervalMode, Converter={StaticResource VisibleIfTrue}}">
                                                <TextBlock Text="{loc:Tr 'Every (Hours):'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBox Text="{Binding Advanced.ScheduledRebootIntervalHours}" Width="80" ClearButtonEnabled="False" PlaceholderText="24" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:CardControl>

                                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Chat24}" IsEnabled="{Binding Advanced.EnableScheduledReboot}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'In-Game Warning'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Broadcast countdown notifications in Minecraft server chat before restarting.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Advanced.ScheduledRebootWarning}" VerticalAlignment="Center"/>
                                    </ui:CardControl>

                                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Timer24}" IsEnabled="{Binding Advanced.IsWarningSettingsEnabled}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Warning Countdown'}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:Tr 'Duration in seconds to alert online players before the reboot begins.'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Tr 'Seconds:'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBox Text="{Binding Advanced.ScheduledRebootWarningSeconds}" Width="80" ClearButtonEnabled="False" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:CardControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 7: ADVANCED EDITOR -->
                        <TabItem Header="{loc:Tr 'Advanced'}">
                            <ScrollViewer x:Name="AdvancedScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <StackPanel>
                                    <ui:Card Padding="24" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Internal Properties (server.properties)'}" Style="{StaticResource SettingsHeader}"/>
                                            <TextBlock Text="{loc:Tr 'Directly modify internal key-value pairs. Core properties are protected.'}" Style="{StaticResource SettingsSubtext}" Margin="0,0,0,20"/>
                                            <ui:Button Content="{loc:Tr 'Append Parameter'}" Command="{Binding Advanced.AddPropertyCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon Add20}"/>
                                        </StackPanel>
                                    </ui:Card>

                                    <ItemsControl ItemsSource="{Binding Advanced.AdvancedProperties}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ui:TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCore, Converter={StaticResource InvertedBooleanConverter}}" Margin="0,0,12,0"/>
                                                    <ui:TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete20}" Appearance="Danger" Command="{Binding DataContext.Advanced.RemovePropertyCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="12,0,0,0" Visibility="{Binding IsCore, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 8: AI SUMMARIES -->
                        <TabItem Header="{loc:Tr 'AISummaries'}">
                            <ScrollViewer x:Name="SummariesScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                                <Grid>
                                    <!-- Summary List View -->
                                    <StackPanel Visibility="{Binding Summaries.IsViewingSummary, Converter={StaticResource InvertedVisibilityConverter}}">
                                        <ui:Card Padding="24" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr 'Session Summaries'}" Style="{StaticResource SettingsHeader}" FontSize="18"/>
                                                <TextBlock Text="{loc:Tr 'AI-generated summaries of your server play sessions. Each summary captures player activity, deaths, events, and highlights.'}"
                                                           Style="{StaticResource SettingsSubtext}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            </StackPanel>
                                        </ui:Card>

                                        <!-- Empty State -->
                                        <ui:Card Padding="32" Margin="0,0,0,16"
                                                 Visibility="{Binding Summaries.HasSummaries, Converter={StaticResource InvertedVisibilityConverter}, FallbackValue=Visible}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="36" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="{loc:Tr 'No summaries yet'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{loc:Tr 'Summaries will appear here after you stop a server session and choose to generate one.'}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,6,0,0" MaxWidth="360"/>
                                            </StackPanel>
                                        </ui:Card>

                                        <!-- Summaries List -->
                                        <ItemsControl ItemsSource="{Binding Summaries.Summaries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card Margin="0,0,0,10" Padding="16,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding SessionDate}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                                    <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="#89B4FA"/>
                                                                    </Border>
                                                                    <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Provider}" FontSize="11" Foreground="#A6E3A1"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Preview}" FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="500" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Content="{loc:Tr 'View'}" Appearance="Secondary"
                                                                           Command="{Binding DataContext.Summaries.ViewSummaryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                           CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                                                <ui:Button Icon="{ui:SymbolIcon Delete20}" Appearance="Danger"
                                                                           Command="{Binding DataContext.Summaries.DeleteSummaryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                           CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Summary Content Viewer -->
                                    <StackPanel Visibility="{Binding Summaries.IsViewingSummary, Converter={StaticResource VisibleIfTrue}}">
                                        <ui:Button Content="{loc:Tr '← Back to Summaries'}" Appearance="Transparent"
                                                   Command="{Binding Summaries.CloseSummaryCommand}" Margin="0,0,0,12"/>
                                        <ui:Card Padding="16" MinHeight="400">
                                            <intel:NativeMarkdownViewer Markdown="{Binding Summaries.SummaryContent, Mode=OneWay}" />
                                        </ui:Card>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
