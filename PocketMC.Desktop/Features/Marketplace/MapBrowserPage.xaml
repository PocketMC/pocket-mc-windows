<Page x:Class="PocketMC.Desktop.Features.Marketplace.MapBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Map Browser">

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="Back"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           MinWidth="88"
                           Margin="0,0,14,0"
                           Click="BtnBack_Click"/>

                <ui:TextBlock x:Name="TxtTitle"
                              FontTypography="Title"
                              Text="World Maps Browser"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              VerticalAlignment="Center"/>
            </StackPanel>
            
            <ui:Button Content="Browse More on Web" 
                       Appearance="Secondary" 
                       Icon="{ui:SymbolIcon Globe24}" 
                       HorizontalAlignment="Right" 
                       Click="BtnWebBrowse_Click"
                       ToolTip="Open minecraftmaps.com"/>
        </Grid>

        <!-- Search and Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <ui:Card Padding="16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:AutoSuggestBox x:Name="TxtSearch" PlaceholderText="Search maps..." Width="260" Margin="0,0,16,0"
                                       Icon="{ui:SymbolIcon Search24}" TextChanged="TxtSearch_TextChanged"
                                       KeyDown="TxtSearch_KeyDown"/>

                    <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="CmbSource" Width="130" Margin="0,0,16,0" IsEnabled="False">
                        <ComboBoxItem Content="CurseForge" IsSelected="True"/>
                    </ComboBox>

                    <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="CmbSort" Width="160" Margin="0,0,16,0" SelectionChanged="RefreshList_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Relevancy" Tag="1"/>
                        <ComboBoxItem Content="Popularity" Tag="2"/>
                        <ComboBoxItem Content="Latest Update" Tag="3"/>
                        <ComboBoxItem Content="Name" Tag="4"/>
                        <ComboBoxItem Content="Total Downloads" Tag="6"/>
                    </ComboBox>

                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="CmbCategory" Width="160" Margin="0,0,16,0" SelectionChanged="RefreshList_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="All Categories" Tag=""/>
                        <ComboBoxItem Content="Adventure" Tag="248"/>
                        <ComboBoxItem Content="Creation" Tag="249"/>
                        <ComboBoxItem Content="Game Map" Tag="250"/>
                        <ComboBoxItem Content="Modded World" Tag="4464"/>
                        <ComboBoxItem Content="Parkour" Tag="251"/>
                        <ComboBoxItem Content="Puzzle" Tag="252"/>
                        <ComboBoxItem Content="Survival" Tag="253"/>
                    </ComboBox>

                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtMcVersion" Text="Minecraft 1.20.1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ResultsScrollViewer" Grid.Row="2" Margin="0" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" ScrollChanged="ResultsScrollViewer_ScrollChanged">
                <StackPanel>
                    <!-- Marketplace Skeleton (Zero-delay, active only during search/load) -->
                    <StackPanel x:Name="SkeletonList" Visibility="{Binding Visibility, ElementName=ProgressSearching}">
                        <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="64" Height="64" CornerRadius="8"/>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SkeletonElement}" Height="18" Width="180" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SkeletonElement}" Height="14" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SkeletonElement}" Height="12" Width="80" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="90" Height="36" CornerRadius="6" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SkeletonCardBorder}" Margin="0,0,0,12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="64" Height="64" CornerRadius="8"/>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SkeletonElement}" Height="18" Width="150" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SkeletonElement}" Height="14" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SkeletonElement}" Height="12" Width="70" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="90" Height="36" CornerRadius="6" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <ItemsControl x:Name="ListResults" ItemsSource="{Binding}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=ProgressSearching}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,12" Padding="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64" Height="64" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Downloads, StringFormat={}{0:N0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <ui:Button x:Name="BtnAction" Width="90" Height="36"
                                                       Click="BtnInstall_Click" Tag="{Binding Slug}" Appearance="Primary" Content="Import"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:ProgressRing x:Name="ProgressLoadMore" IsIndeterminate="True" Width="24" Height="24" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,16"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty State Placeholder (Visible when not searching and results are empty) -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ui:SymbolIcon Symbol="Search24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ui:TextBlock FontTypography="Subtitle" Text="No results found" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ui:TextBlock x:Name="TxtEmptyStateDetail" Text="We couldn't find any worlds matching your criteria. Try adjusting your search query or category." FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" Margin="0,0,0,20"/>
                <ui:Button x:Name="BtnResetFilters" Content="Reset Filters" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Center" Click="BtnResetFilters_Click"/>
            </StackPanel>

            <!-- CurseForge API Key Missing/Invalid Placeholder -->
            <StackPanel x:Name="CurseForgeKeyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,32" MaxWidth="460">
                <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ui:SymbolIcon Symbol="Key24" FontSize="36" Foreground="#F9E2AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <ui:TextBlock x:Name="TxtCurseForgeKeyTitle" FontTypography="Subtitle" Text="CurseForge API Key Required" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                
                <ui:TextBlock x:Name="TxtCurseForgeKeyDetail" Text="CurseForge requires a free API key to search and download worlds. Enter your key to continue." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>
                
                <ui:Button x:Name="BtnConfigureCurseForgeKey" Content="Configure API Key" Appearance="Primary" Icon="{ui:SymbolIcon Key24}" HorizontalAlignment="Center" Padding="20,8" Margin="0,0,0,16" Click="BtnConfigureCurseForgeKey_Click"/>

                <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="Get a free key at "/>
                    <Hyperlink NavigateUri="https://console.curseforge.com/#/api-keys/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                        <Run Text="console.curseforge.com"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <ui:ProgressRing x:Name="ProgressSearching" IsIndeterminate="True" Width="40" Height="40" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
