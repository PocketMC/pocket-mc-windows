<ui:FluentWindow x:Class="PocketMC.Desktop.Features.News.NewsPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:news="clr-namespace:PocketMC.Desktop.Features.News"
        Title="PocketMC News"
        Width="620" Height="620" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowCornerPreference="Round" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="PocketMC News" ShowMaximize="False" ShowMinimize="False"/>
        <news:NewsArticleView x:Name="ArticleView" Grid.Row="1" Margin="24,14,24,8"/>
        <Grid Grid.Row="2" Margin="24,10,24,20">
            <ui:Button Content="Got it" Appearance="Primary" MinWidth="100"
                       HorizontalAlignment="Right" IsDefault="True"
                       Click="GotIt_Click" AutomationProperties.Name="Acknowledge news item"/>
        </Grid>
    </Grid>
</ui:FluentWindow>