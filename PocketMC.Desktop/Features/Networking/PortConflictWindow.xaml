<ui:FluentWindow x:Class="PocketMC.Desktop.Features.Networking.PortConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Port Conflict"
        Width="480"
        SizeToContent="Height"
        MinWidth="420" MaxWidth="540"
        MinHeight="0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyboardNavigation.TabNavigation="Cycle"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid MaxWidth="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Port Conflict" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="28,4,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: icon + title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <ui:SymbolIcon Symbol="Warning24"
                               FontSize="24"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtTitle"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Error message -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="140"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,14">
                <TextBlock x:Name="TxtMessage"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"/>
            </ScrollViewer>

            <!-- Suggested Port Action Card -->
            <Border x:Name="BorderSuggestedPort"
                    Grid.Row="2"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="RECOMMENDED REPLACEMENT"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtSuggestedPortDescription"
                                   Text="Port 25566 is verified available"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:Button x:Name="BtnApplySuggested"
                               Grid.Column="1"
                               Appearance="Primary"
                               Content="Use Port"
                               Icon="{ui:SymbolIcon Sparkle24}"
                               Click="BtnApplySuggested_Click"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Use recommended replacement port"
                               Padding="12,6"/>
                </Grid>
            </Border>

            <!-- Port input section -->
            <StackPanel Grid.Row="3" Margin="0,0,0,6">
                <TextBlock Text="Enter or modify port:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,8"/>

                <ui:TextBox x:Name="TxtPortInput"
                            PlaceholderText="e.g. 25566"
                            FontSize="14"
                            MaxLength="5"
                            AutomationProperties.Name="Server port number input"
                            TextChanged="TxtPortInput_TextChanged"/>

                <!-- Validation message -->
                <TextBlock x:Name="TxtValidation"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Success message -->
                <TextBlock x:Name="TxtSuccess"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Cancel"
                           Appearance="Secondary"
                           MinWidth="80"
                           Margin="0,0,8,0"
                           Click="Cancel_Click"
                           AutomationProperties.Name="Cancel port change"
                           IsCancel="True"/>
                <ui:Button x:Name="BtnConfirm"
                           Content="Change Port &amp; Start"
                           Appearance="Primary"
                           MinWidth="140"
                           Click="Confirm_Click"
                           IsDefault="True"
                           AutomationProperties.Name="Change port and start server"
                           IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
