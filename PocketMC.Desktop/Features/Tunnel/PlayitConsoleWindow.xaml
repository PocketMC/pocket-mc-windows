<ui:FluentWindow x:Class="PocketMC.Desktop.Features.Tunnel.PlayitConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Playit Agent Console"
        Width="880" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar with Minimize, Maximize, Close (X) buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Native Fluent TitleBar with standard Windows controls -->
        <ui:TitleBar Grid.Row="0"
                     Title="Playit Agent Console"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True"
                     Margin="0,0,0,4"/>

        <!-- Main Window Body -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Action Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Agent Status Badge matching exact height, padding and corner radius of adjacent buttons -->
                <Border Grid.Column="0"
                        Height="32"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0" Fill="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Offline" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Auto-scroll Toggle -->
                <ToggleButton x:Name="BtnAutoScroll" Grid.Column="1"
                              Content="Auto-scroll"
                              Height="32"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Cursor="Hand"
                              Padding="12,0"
                              ToolTip="Automatically scroll to bottom on new logs"/>

                <!-- Copy Logs Button -->
                <ui:Button x:Name="BtnCopyLogs" Grid.Column="2"
                           Content="Copy Logs"
                           Height="32"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Copy24}"
                           Click="BtnCopyLogs_Click"
                           Cursor="Hand"
                           Margin="0,0,8,0"
                           Padding="12,0"
                           ToolTip="Copy all logs to clipboard"/>

                <!-- Clear Button -->
                <ui:Button x:Name="BtnClearLogs" Grid.Column="3"
                           Content="Clear"
                           Height="32"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Delete24}"
                           Click="BtnClearLogs_Click"
                           Cursor="Hand"
                           Margin="0,0,8,0"
                           Padding="12,0"
                           ToolTip="Clear console display"/>

                <!-- Search Logs Box -->
                <ui:TextBox x:Name="TxtLogSearch" Grid.Column="4"
                            Height="32"
                            PlaceholderText="Filter logs..."
                            VerticalAlignment="Center"
                            TextChanged="TxtLogSearch_TextChanged"
                            KeyDown="TxtLogSearch_KeyDown"
                            ToolTip="Filter logs by keyword"/>
            </Grid>

            <!-- Console Log Output Area -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <RichTextBox x:Name="LogRichTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="4,2">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" Icon="{ui:SymbolIcon Copy24}"/>
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" Icon="{ui:SymbolIcon SelectAllOn24}"/>
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                    <FlowDocument PagePadding="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13">
                        <Paragraph x:Name="LogParagraph" Margin="0" LineHeight="19" />
                    </FlowDocument>
                </RichTextBox>
            </Border>

            <!-- Bottom Status / Path Bar -->
            <Grid Grid.Row="2" Margin="4,8,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLogCount" Grid.Column="0"
                           Text="0 lines"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLogFilePath" Grid.Column="1"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
