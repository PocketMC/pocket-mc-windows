<Page x:Class="PocketMC.Desktop.Features.Shell.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About">

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <ui:TextBlock x:Name="TxtAboutTitle" FontTypography="Title" Text="About PocketMC" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtVersion" Text="Version 1.0.0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
        </StackPanel>

        <ScrollViewer x:Name="AboutScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Padding="0,0,16,0">
            <StackPanel>
                <ui:Card Padding="24" VerticalAlignment="Top" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo -->
                    <Border Grid.Column="0"
                            Width="120" Height="120"
                            CornerRadius="16"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,120,120" RadiusX="16" RadiusY="16"/>
                        </Border.Clip>
                        <Image Source="pack://application:,,,/Assets/logo_highres.png"
                                Stretch="UniformToFill"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True"
                                RenderOptions.BitmapScalingMode="Fant"
                                RenderOptions.EdgeMode="Aliased"/>
                    </Border>

                    <!-- Info Content -->
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock x:Name="TxtAppTitle" Text="PocketMC Desktop" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtAppDescription" Text="A modern native desktop application for managing Minecraft servers, proxies, modpacks, and more." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="Repository" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Contributions, issues, and feature requests are welcome on GitHub!" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="GitHub" Appearance="Secondary" Click="OpenGitHub_Click" Icon="{ui:SymbolIcon Code24}"/>
                            <ui:Button Content="View What's New" Appearance="Primary" Margin="8,0,0,0" Click="WhatsNew_Click" Icon="{ui:SymbolIcon Megaphone24}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ORGANIZATION / COMPANY SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon Building24}" Margin="0,0,0,12">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TxtOrgName" Text="DS LABS" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtOrgTagline" Text="Selective Digital Studio · Building Software That Works" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Content="Visit Website" Appearance="Primary" Click="OpenOrganizationWebsite_Click" Icon="{ui:SymbolIcon Globe20}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- CO-FOUNDERS SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon PeopleStar24}" Margin="0,0,0,12">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Co-Founders &amp; Contributors" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Co-Founders of DS Labs · Creators of PocketMC" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,10,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Click="OpenDivyGitHub_Click"
                                   Appearance="Transparent"
                                   Padding="14,10"
                                   CornerRadius="8"
                                   Cursor="Hand"
                                   ToolTip="https://github.com/divyviradiya2"
                                   Margin="0,0,16,0"
                                   HorizontalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="52" Height="52" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Border Width="52" Height="52"
                                            CornerRadius="26"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Clip>
                                            <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                                        </Border.Clip>
                                        <Image x:Name="ImgDivyAvatar"
                                               Source="pack://application:,,,/Assets/avatar_divyviradiya.png"
                                               Width="52" Height="52"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Ellipse Width="52" Height="52"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             StrokeThickness="1"/>
                                </Grid>
                                <TextBlock Text="Divy Viradiya"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Co-Founder"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Click="OpenSahajGitHub_Click"
                                   Appearance="Transparent"
                                   Padding="14,10"
                                   CornerRadius="8"
                                   Cursor="Hand"
                                   ToolTip="https://github.com/SizWinz"
                                   HorizontalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="52" Height="52" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Border Width="52" Height="52"
                                            CornerRadius="26"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Clip>
                                            <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                                        </Border.Clip>
                                        <Image x:Name="ImgSahajAvatar"
                                               Source="pack://application:,,,/Assets/avatar_sahajitaliya.png"
                                               Width="52" Height="52"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Ellipse Width="52" Height="52"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             StrokeThickness="1"/>
                                </Grid>
                                <TextBlock Text="Sahaj Italiya"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Co-Founder"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- HELPERS SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon PersonHeart24}" Margin="0,0,0,12">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Helpers" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Community members helping with testing, development, and social media." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,10,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Click="OpenJohndinglesinGitHub_Click"
                                   Appearance="Transparent"
                                   Padding="14,10"
                                   CornerRadius="8"
                                   Cursor="Hand"
                                   ToolTip="Johndinglesin · Testing, Development &amp; Social Media"
                                   HorizontalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="52" Height="52" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Border Width="52" Height="52"
                                            CornerRadius="26"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Clip>
                                            <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                                        </Border.Clip>
                                        <Image x:Name="ImgJohndinglesinAvatar"
                                               Source="pack://application:,,,/Assets/avatar_johndinglesin.png"
                                               Width="52" Height="52"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Ellipse Width="52" Height="52"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             StrokeThickness="1"/>
                                </Grid>
                                <TextBlock Text="Johndinglesin"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Helper"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- DONATORS SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon RibbonStar24}" Margin="0,0,0,12">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Donators" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Special thanks to our generous donators supporting PocketMC." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,10,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Click="OpenNexViceDiscord_Click"
                                   Appearance="Transparent"
                                   Padding="14,10"
                                   CornerRadius="8"
                                   Cursor="Hand"
                                   ToolTip="NexVice (@nexvice)"
                                   HorizontalContentAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="52" Height="52" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Border Width="52" Height="52"
                                            CornerRadius="26"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Clip>
                                            <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                                        </Border.Clip>
                                        <Image x:Name="ImgNexViceAvatar"
                                               Source="pack://application:,,,/Assets/avatar_nexvice.png"
                                               Width="52" Height="52"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Ellipse Width="52" Height="52"
                                             Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             StrokeThickness="1"/>
                                </Grid>
                                <TextBlock Text="NexVice"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Donator"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- COMMUNITY SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon People24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Community" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCommunityDesc" Text="Join our Discord server to get help, share tips, and connect with other PocketMC users." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Content="Join Discord" Appearance="Primary" Click="OpenDiscord_Click"/>
                        <ui:Button Content="Copy Invite" Appearance="Secondary" Margin="8,0,0,0" Click="CopyDiscordInvite_Click"/>
                        <ui:Button Content="Instagram" Appearance="Secondary" Margin="8,0,0,0" Click="OpenInstagram_Click" Icon="{ui:SymbolIcon Camera24}"/>
                        <ui:Button Content="YouTube" Appearance="Secondary" Margin="8,0,0,0" Click="OpenYouTube_Click" Icon="{ui:SymbolIcon Video24}"/>
                        <ui:Button Content="Reddit" Appearance="Secondary" Margin="8,0,0,0" Click="OpenReddit_Click" Icon="{ui:SymbolIcon Chat24}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>
            <!-- FEEDBACK SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon Bug24}" Margin="0,12,0,0">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Feedback &amp; Support" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="For bugs, support, and help, you can contact us directly on Discord or submit our feedback form." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Content="Submit Feedback Form" Appearance="Primary" Click="OpenFeedbackForm_Click" Icon="{ui:SymbolIcon Open20}"/>
                        <ui:Button Content="Get Help on Discord" Appearance="Secondary" Margin="8,0,0,0" Click="OpenDiscord_Click" Icon="{ui:SymbolIcon People20}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- SUPPORT & DONATION SECTION -->
            <ui:CardExpander IsExpanded="True" Icon="{ui:SymbolIcon Heart24}" Margin="0,12,0,0">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Support &amp; Donation" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtDonationDesc" Text="Support the development of PocketMC! If you love this project and find it useful, consider buying us a coffee." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="16,8,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Content="Buy Me a Coffee" Appearance="Primary" Click="OpenDonationPage_Click" Icon="{ui:SymbolIcon Heart20}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
