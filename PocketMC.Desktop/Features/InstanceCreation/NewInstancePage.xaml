<Page x:Class="PocketMC.Desktop.Features.InstanceCreation.NewInstancePage" xmlns:loc="clr-namespace:PocketMC.Desktop.Localization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:presentation="clr-namespace:PocketMC.Desktop.Core.Presentation"
      Title="{loc:Tr 'New Instance'}"
      SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        <presentation:InverseBooleanToVisibilityConverter x:Key="InvertedVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="28,20,28,24" VerticalAlignment="Stretch">
        <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <ui:Button Content="{loc:Tr 'Back'}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           MinWidth="88"
                           Margin="0,0,14,0"
                           Click="BtnBack_Click"/>

                <ui:TextBlock FontTypography="Title"
                              Text="{loc:Tr 'Create a New Instance'}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <ui:Button x:Name="BtnImportModpack"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Click="BtnImportModpack_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderZip24" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr 'Import Modpack'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Background="#33FFB347" BorderBrush="#FFFFB347" BorderThickness="1" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr 'BETA'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFB347" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnImportInstance"
                           Content="{loc:Tr 'Import Instance'}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowUpload24}"
                           MinWidth="136"
                           Click="BtnImportInstance_Click"/>
            </StackPanel>
        </Grid>

        <!-- Footer Action Bar -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <!-- EULA Checkbox -->
                    <StackPanel x:Name="EulaPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                        <CheckBox x:Name="ChkAcceptEula" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkAcceptEula_Changed" Unchecked="ChkAcceptEula_Changed"/>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr 'I accept the Minecraft End User License Agreement'}" FontWeight="Medium" FontSize="13" Margin="0,0,0,2"/>
                            <TextBlock FontSize="12" Opacity="0.8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="{loc:Tr 'PocketMC will write eula.txt automatically. Review'}"/>
                                <Hyperlink NavigateUri="https://aka.ms/MinecraftEULA" RequestNavigate="MinecraftEulaLink_RequestNavigate"><Run Text="{loc:Tr 'Mojang EULA'}"/></Hyperlink>
                                <Run Text="{loc:Tr 'before creating the instance.'}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Error Callout -->
                    <Border x:Name="ErrorCallout"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Background="#26F44336"
                            BorderBrush="#66F44336"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="#FFF44336"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtError"
                                       Foreground="#FFF44336"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Download Progress Panel -->
                    <StackPanel x:Name="ProgressOverlay"
                                Visibility="Collapsed"
                                Margin="0,4,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"/>
                                <ui:TextBlock x:Name="TxtDownloadStage"
                                           FontTypography="BodyStrong"
                                           Text="{loc:Tr 'Preparing Server...'}"
                                           VerticalAlignment="Center"
                                           FontSize="13"/>
                            </StackPanel>
                            
                            <TextBlock x:Name="TxtProgress"
                                       Grid.Column="1"
                                       Text="{loc:Tr 'Waiting for download...'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        
                        <ProgressBar x:Name="PrgDownload"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,0,0,0"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCancel"
                               Content="{loc:Tr 'Cancel'}"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Click="BtnBack_Click"
                               IsCancel="True"/>

                    <ui:Button x:Name="BtnCreate"
                               Content="{loc:Tr 'Create and Download'}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Click="BtnCreate_Click"
                               IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <!-- New Instance Page Skeleton Loader (Zero-delay, active only during version/provider load) -->
            <Grid Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource VisibleIfTrue}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Left Skeleton Card -->
                <Border Grid.Column="0" Style="{StaticResource SkeletonCardBorder}" Padding="24" Height="420" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4" Margin="0,0,12,0"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="180"/>
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonElement}" Height="14" Width="100" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="38" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="14" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="38" Margin="0,0,0,24"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="40" Margin="0,0,0,16"/>
                    </StackPanel>
                </Border>
                <!-- Right Skeleton Card -->
                <Border Grid.Column="2" Style="{StaticResource SkeletonCardBorder}" Padding="24" Height="420" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4" Margin="0,0,12,0"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="160"/>
                        </StackPanel>
                        <Border Style="{StaticResource SkeletonElement}" Height="14" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="38" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="14" Width="110" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="38" Margin="0,0,0,24"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="14" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource SkeletonElement}" Height="40" Margin="0,0,0,16"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InvertedVisibilityConverter}}">
                <StackPanel x:Name="ContentLayoutRoot" HorizontalAlignment="Stretch">

            <Grid x:Name="InputsPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Col0" Width="*"/>
                    <ColumnDefinition x:Name="Col1" Width="0"/>
                    <ColumnDefinition x:Name="Col2" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="Row0" Height="Auto"/>
                    <RowDefinition x:Name="Row1" Height="0"/>
                    <RowDefinition x:Name="Row2" Height="Auto"/>
                    <RowDefinition x:Name="Row3" Height="0"/>
                    <RowDefinition x:Name="Row4" Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left Column: Basics & Software -->
                <ui:Card x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Margin="0,0,12,24" VerticalAlignment="Top" Padding="24">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <ui:SymbolIcon Symbol="Server24" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="{loc:Tr 'Server Identity &amp; Software'}" FontTypography="BodyStrong" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Server Name -->
                        <TextBlock Text="{loc:Tr 'Server Name'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox x:Name="TxtName" PlaceholderText="{loc:Tr 'My Cool Server'}" Margin="0,0,0,16"/>

                        <!-- Description -->
                        <TextBlock Text="{loc:Tr 'Description'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox x:Name="TxtDescription" PlaceholderText="{loc:Tr 'What this instance is for'}" Margin="0,0,0,24"/>
                        
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,24"/>

                        <!-- Server Type -->
                        <TextBlock Text="{loc:Tr 'Server Type'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox x:Name="CmbServerType" Margin="0,0,0,16" HorizontalAlignment="Stretch" MinHeight="40" SelectionChanged="CmbServerType_SelectionChanged">
                            <ComboBoxItem Tag="Vanilla" Content="{loc:Tr 'Vanilla'}" IsSelected="True"/>
                            <ComboBoxItem Tag="Paper" Content="{loc:Tr 'Paper'}"/>
                            <ComboBoxItem Tag="Fabric" Content="{loc:Tr 'Fabric'}"/>
                            <ComboBoxItem Tag="Forge" Content="{loc:Tr 'Forge'}"/>
                            <ComboBoxItem Tag="NeoForge" Content="{loc:Tr 'NeoForge'}"/>
                            <ComboBoxItem Tag="Bedrock (BDS)" Content="{loc:Tr 'Bedrock (BDS)'}"/>
                            <ComboBoxItem Tag="Pocketmine (PHP)" Content="{loc:Tr 'Pocketmine (PHP)'}"/>
                        </ComboBox>

                        <!-- Minecraft Version -->
                        <TextBlock Text="{loc:Tr 'Minecraft Version'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox x:Name="CmbVersion" Margin="0,0,0,8" HorizontalAlignment="Stretch" MinHeight="40" DisplayMemberPath="Id" SelectionChanged="CmbVersion_SelectionChanged"/>
                        
                        <TextBlock x:Name="TxtVersionState" Text="{loc:Tr 'Choose a server type to load available versions.'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Snapshots & Warnings -->
                        <CheckBox x:Name="ChkShowSnapshots" Content="{loc:Tr 'Show snapshots and pre-releases'}" Checked="ChkShowSnapshots_Changed" Unchecked="ChkShowSnapshots_Changed" Margin="0,0,0,16"/>

                        <!-- Loader Version -->
                        <StackPanel x:Name="LoaderVersionPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtLoaderVersionLabel" Text="{loc:Tr 'Loader Version'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbLoaderVersion" HorizontalAlignment="Stretch" MinHeight="40" DisplayMemberPath="Version"/>
                        </StackPanel>

                        <!-- Addon Panel (Cross-play) -->
                        <StackPanel x:Name="AddonPanel" Margin="0,0,0,0">
                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkEnableGeyser" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Tr 'Enable Cross-play (Geyser + Floodgate)'}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="12" Opacity="0.8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{loc:Tr 'Allows Minecraft Bedrock players to join this Java server.'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Right Column: World & Gameplay Settings -->
                <ui:Card x:Name="RightPanel" Grid.Column="2" Grid.Row="0" Margin="12,0,0,24" VerticalAlignment="Top" Padding="24">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <ui:SymbolIcon Symbol="Earth24" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock Text="{loc:Tr 'World &amp; Gameplay Settings'}" FontTypography="BodyStrong" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <!-- World Seed -->
                        <TextBlock Text="{loc:Tr 'World Seed'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox x:Name="TxtSeed" PlaceholderText="{loc:Tr 'Leave empty for random seed'}" Margin="0,0,0,16"/>

                        <!-- World Generation Type -->
                        <TextBlock Text="{loc:Tr 'World Generation Type'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox x:Name="CmbLevelType" Margin="0,0,0,16" HorizontalAlignment="Stretch" MinHeight="40">
                            <ComboBoxItem Content="{loc:Tr 'Default'}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:Tr 'Flat'}"/>
                            <ComboBoxItem Content="{loc:Tr 'LargeBiomes'}"/>
                            <ComboBoxItem Content="{loc:Tr 'Amplified'}"/>
                        </ComboBox>
                        
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,8,0,24"/>

                        <!-- Default Gamemode -->
                        <TextBlock Text="{loc:Tr 'Default Gamemode'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox x:Name="CmbGamemode" Margin="0,0,0,16" HorizontalAlignment="Stretch" MinHeight="40">
                            <ComboBoxItem Content="{loc:Tr 'Survival'}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:Tr 'Creative'}"/>
                            <ComboBoxItem Content="{loc:Tr 'Adventure'}"/>
                            <ComboBoxItem Content="{loc:Tr 'Spectator'}"/>
                        </ComboBox>

                        <!-- World Difficulty -->
                        <TextBlock Text="{loc:Tr 'World Difficulty'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox x:Name="CmbDifficulty" Margin="0,0,0,16" HorizontalAlignment="Stretch" MinHeight="40">
                            <ComboBoxItem Content="{loc:Tr 'Peaceful'}"/>
                            <ComboBoxItem Content="{loc:Tr 'Easy'}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:Tr 'Normal'}"/>
                            <ComboBoxItem Content="{loc:Tr 'Hard'}"/>
                        </ComboBox>

                        <!-- Players Limit -->
                        <TextBlock Text="{loc:Tr 'Players Limit'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox x:Name="TxtMaxPlayers" Text="20" ClearButtonEnabled="False" Margin="0,0,0,24"/>
                        
                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,24"/>

                        <!-- Custom World Upload -->
                        <TextBlock Text="{loc:Tr 'Custom World Upload (.zip / .mcworld)'}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtCustomWorldPath" PlaceholderText="{loc:Tr 'Optional (.zip / .mcworld)'}" IsReadOnly="True" Margin="0,0,8,0"/>
                            <ui:Button x:Name="BtnBrowseWorld" Grid.Column="1" Content="{loc:Tr 'Browse'}" Appearance="Secondary" MinHeight="40" Click="BtnBrowseWorld_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </DockPanel>
    </Grid>
</Page>
