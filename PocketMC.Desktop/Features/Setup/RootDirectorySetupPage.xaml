<Page x:Class="PocketMC.Desktop.Features.Setup.RootDirectorySetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Setup">

    <Grid Margin="36,28,36,28">
        <Border MaxWidth="660"
                Padding="32"
                CornerRadius="20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="PocketMC"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,16"/>

                <ui:TextBlock FontTypography="Title"
                              Text="Choose a home folder for PocketMC"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Margin="0,0,0,10"/>

                <TextBlock Text="PocketMC needs one home folder before setup can continue. This is where the app stores Java runtimes, server files, backups, and PocketMC app data."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Folder name"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="TxtSuggestedFolderName"
                         IsReadOnly="True"
                         Text="PocketMC"
                         Padding="14,10"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Background="#12000000"
                         BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                         BorderThickness="1"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Folder preview"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="TxtSuggestedPath"
                         IsReadOnly="True"
                         Padding="14,10"
                         FontFamily="Consolas"
                         TextWrapping="Wrap"
                         Background="#12000000"
                         BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                         BorderThickness="1"
                         Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:Button x:Name="SelectDirectoryButton"
                               Content="Select Directory"
                               Icon="{ui:SymbolIcon Folder24}"
                               Appearance="Primary"
                               MinWidth="164"
                               HorizontalAlignment="Left"
                               Click="BtnSelectDirectory_Click"
                               Cursor="Hand"/>

                    <ui:Button x:Name="ContinueButton"
                               Content="Continue"
                               Appearance="Secondary"
                               MinWidth="128"
                               Margin="12,0,0,0"
                               Click="BtnContinue_Click"
                               Cursor="Hand"/>
                </StackPanel>

                <!-- Dedicated Separated Restore Option -->
                <Border Height="1" 
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" 
                        Margin="0,24,0,16" 
                        Opacity="0.4"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Have an existing setup?"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <ui:Button x:Name="RestoreBackupButton"
                               Content="Restore Saved Settings"
                               Icon="{ui:SymbolIcon ArrowUpload24}"
                               Appearance="Transparent"
                               Margin="10,0,0,0"
                               Padding="10,6"
                               Click="BtnRestoreBackup_Click"
                               Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
