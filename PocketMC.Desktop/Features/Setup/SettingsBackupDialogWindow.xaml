<ui:FluentWindow x:Class="PocketMC.Desktop.Features.Setup.SettingsBackupDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding ElementName=TxtTitle, Path=Text}"
        Width="580" Height="680"
        MinWidth="480" MaxWidth="680"
        MinHeight="450" MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Margin="-24,-12,-24,0" ShowMaximize="False" ShowMinimize="False"/>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="0,8,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ui:SymbolIcon x:Name="HeaderIcon" Symbol="ArrowDownload24" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="TxtTitle" Text="Backup Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtSubtitle" Text="Select the settings, paths, and credentials you want to include in the backup file." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Quick selection toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Categories &amp; Data:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Select All" Appearance="Secondary" Padding="8,3" FontSize="11" Click="SelectAll_Click" Margin="0,0,6,0"/>
                <ui:Button Content="Deselect All" Appearance="Secondary" Padding="8,3" FontSize="11" Click="DeselectAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Categories List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Margin="0,0,0,16">
            <ItemsControl x:Name="CategoriesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Padding="12,10"
                                IsEnabled="{Binding IsAvailable}"
                                Opacity="{Binding CardOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"/>

                                <ui:SymbolIcon Grid.Column="1"
                                               Symbol="{Binding Symbol}"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Visibility="{Binding IsSensitive, Converter={StaticResource VisibleIfTrue}}"
                                                Background="#33E5A50A"
                                                BorderBrush="#88E5A50A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Credentials / Key" FontSize="10" FontWeight="SemiBold" Foreground="#F9E2AF"/>
                                        </Border>
                                        <Border Visibility="{Binding UnavailableBadgeVisibility}"
                                                Background="#22FFFFFF"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Not in backup file" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatusWarning"
                       FontSize="11"
                       Foreground="#F9E2AF"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"
                       Visibility="Collapsed"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" MinWidth="80" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <ui:Button x:Name="BtnAction" Content="Export Backup..." Appearance="Primary" MinWidth="120" Click="BtnAction_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
