                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                    <TextBlock Text="{loc:Tr 'Enter'}" FontSize="12" FontWeight="SemiBold"/>
