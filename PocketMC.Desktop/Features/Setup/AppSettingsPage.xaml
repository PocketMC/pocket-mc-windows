                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Ollama Mode'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Choose between your local Ollama daemon or Ollama Cloud service.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="OllamaModeCombo" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="OllamaModeCombo_SelectionChanged">
                                <ComboBoxItem Content="{loc:Tr 'Local (Self-Hosted)'}" IsSelected="True"/>
                                <ComboBoxItem Content="{loc:Tr 'Ollama Cloud'}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Ollama Daemon Status -->
                        <Grid x:Name="OllamaStatusPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
