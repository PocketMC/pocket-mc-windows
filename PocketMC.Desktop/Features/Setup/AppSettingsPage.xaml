                                               Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Endpoint URL -->
                        <Grid x:Name="EndpointUrlPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
