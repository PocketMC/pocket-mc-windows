                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button x:Name="BtnManageOllamaModels" Grid.Column="0" Content="{loc:Tr 'Manage and Download Models'}" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Click="ManageOllamaModels_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <Grid Grid.Column="1">
                                    <ComboBox x:Name="AiModelCombo"
                                              IsEditable="True"
                                              VerticalAlignment="Center"
                                              SelectionChanged="AiModelCombo_SelectionChanged"
