                        <TextBlock Text="{loc:Tr 'Export your settings into a portable JSON backup file with selectable categories, or restore individual categories into your active configuration without overwriting unselected settings.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>

                        <WrapPanel>
                            <ui:Button x:Name="BtnBackupSettings" Content="{loc:Tr 'Backup Settings...'}" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Margin="0,0,8,0" Click="BackupSettings_Click"/>
                            <ui:Button x:Name="BtnRestoreSettings" Content="{loc:Tr 'Restore from Backup...'}" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Secondary" Margin="0,0,8,0" Click="RestoreSettings_Click"/>
                            <ui:Button x:Name="BtnResetSettings" Content="{loc:Tr 'Reset to Defaults'}" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Secondary" Click="ResetSettings_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Stethoscope24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Diagnostics &amp; Support'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Tools to help troubleshoot and report issues.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <!-- Dependency Health -->
                        <TextBlock Text="{loc:Tr 'External Services Availability'}" FontSize="14" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="DependencyHealthList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding ColorBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,4,0,12" Opacity="0.15"/>

                        <!-- Disaster Recovery -->
                        <TextBlock Text="{loc:Tr 'Disaster Recovery (Off-site Prep)'}" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{loc:Tr 'Set a secondary external location (like a Google Drive or USB directory) where world backups should be replicated automatically when they run.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ui:TextBox x:Name="ExternalBackupPathInput" PlaceholderText="{loc:Tr 'Select an external path...'}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Content="{loc:Tr 'Browse'}" Click="BrowseExternalBackup_Click" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="2" Content="{loc:Tr 'Save'}" Appearance="Primary" Click="SaveExternalBackup_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,4,0,12" Opacity="0.15"/>

                        <TextBlock Text="{loc:Tr 'Export Support Bundle'}" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{loc:Tr 'Generates a ZIP archive containing redacted App logs, system information, and running server metrics. Attach this to GitHub issues or Discord help requests.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <ui:Button x:Name="BtnExportBundle" Content="{loc:Tr 'Generate Support Bundle'}" Icon="{ui:SymbolIcon Archive24}" Appearance="Secondary" Click="ExportBundle_Click"/>
                        <TextBlock x:Name="ExportBundleStatusText" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
