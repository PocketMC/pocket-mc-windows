                            <ui:TextBox x:Name="AiEndpointUrlInput" Grid.Column="1" PlaceholderText="{loc:Tr 'e.g. http://localhost:11434/api/chat'}" Width="300" VerticalAlignment="Center" KeyDown="AiEndpointUrlInput_KeyDown" TextBoxBase.TextChanged="AiEndpointUrlInput_TextChanged"/>
                        </Grid>

                        <!-- Ollama Mode Selector -->
                        <Grid x:Name="OllamaModePanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
