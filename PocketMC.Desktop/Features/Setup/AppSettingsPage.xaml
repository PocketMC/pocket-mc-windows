<Page x:Class="PocketMC.Desktop.Features.Setup.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:PocketMC.Desktop.Localization"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="{loc:Tr 'Settings'}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        <presentation:InverseBooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" xmlns:presentation="clr-namespace:PocketMC.Desktop.Core.Presentation"/>
    </Page.Resources>

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Tr App Settings}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="24,24,24,16" />

        <!-- App Settings Skeleton (Zero-delay, active only during initial render/load) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,0,24,24"
                      Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource VisibleIfTrue}}">
            <StackPanel>
                <Border Style="{StaticResource SkeletonCardBorder}" Height="68" Margin="0,0,0,12" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="24" Height="24" CornerRadius="4" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="12" Width="220" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SkeletonCardBorder}" Height="68" Margin="0,0,0,12" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="24" Height="24" CornerRadius="4" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="120" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="12" Width="260" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SkeletonCardBorder}" Height="68" Margin="0,0,0,12" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="24" Height="24" CornerRadius="4" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="180" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="12" Width="280" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SkeletonCardBorder}" Height="68" Margin="0,0,0,12" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="24" Height="24" CornerRadius="4" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="150" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="12" Width="240" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SkeletonCardBorder}" Height="68" Margin="0,0,0,12" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SkeletonElement}" Width="24" Height="24" CornerRadius="4" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkeletonElement}" Height="18" Width="130" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource SkeletonElement}" Height="12" Width="210" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SkeletonElement}" Width="20" Height="20" CornerRadius="4"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1"
                      x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,0,24,24"
                      Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InvertedVisibilityConverter}}">
            <StackPanel>
                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'App Behavior'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Control startup and tray behavior.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Start PocketMC with Windows'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Automatically launch PocketMC when you sign into Windows.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleStartWithWindows"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleStartWithWindows_Changed"
                                             Unchecked="ToggleStartWithWindows_Changed"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Start minimized to tray'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'When Windows starts PocketMC, keep the dashboard hidden and show the tray icon.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleStartMinimizedToTray"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleStartMinimizedToTray_Changed"
                                             Unchecked="ToggleStartMinimizedToTray_Changed"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Minimize to tray on close'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Keep PocketMC running in the tray when the main window is closed.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleMinimizeToTrayOnClose"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleMinimizeToTrayOnClose_Changed"
                                             Unchecked="ToggleMinimizeToTrayOnClose_Changed"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Optional usage telemetry'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Share app activity and server usage to help improve PocketMC. The first-run installation report, including country, is always sent.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleTelemetry"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleTelemetry_Changed"
                                             Unchecked="ToggleTelemetry_Changed"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Keep this PC awake while servers are running'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Allows the screen to turn off, but prevents Windows from sleeping so servers and tunnels stay online.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleKeepComputerAwakeWhileServersRunning"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleKeepComputerAwakeWhileServersRunning_Changed"
                                             Unchecked="ToggleKeepComputerAwakeWhileServersRunning_Changed"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Globe24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Language &amp; Region'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Choose the interface language for PocketMC.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <TextBlock Text="{loc:Tr Language}" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{loc:Tr 'Some pages are still being translated and may appear in English.'}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <ComboBox x:Name="LanguageCombo"
                                  MinWidth="220"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="LanguageCombo_SelectionChanged"/>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Downloads &amp; Mirrors'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Route blocked or slow downloads through mirror tunnels.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Use download mirrors'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Retry downloads through public mirror tunnels and BMCLAPI when the official host is unreachable.'}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="DownloadMirrorsToggle" VerticalAlignment="Top" Margin="16,0,0,0"
                                             Checked="ToggleUseDownloadMirrors_Changed" Unchecked="ToggleUseDownloadMirrors_Changed"/>
                        </Grid>

                        <TextBlock Text="{loc:Tr 'Custom download mirror'}" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{loc:Tr 'Optional template containing {url}, for example https://ghfast.top/{url}. Leave empty to use the built-in tunnels.'}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <ui:TextBox x:Name="CustomDownloadMirrorInput" MinWidth="320" HorizontalAlignment="Left"
                                    PlaceholderText="https://ghfast.top/{url}"
                                    LostFocus="CustomDownloadMirrorInput_LostFocus"/>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Storage &amp; Root Directory'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Change or transfer the PocketMC root storage folder.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <TextBlock Text="{loc:Tr 'PocketMC Root Folder Path'}" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{loc:Tr 'This folder holds your Minecraft server instances, Java/PHP runtimes, and network tunnel binaries.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="RootDirectoryPathInput" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" x:Name="BtnChangeRootDirectory" Content="{loc:Tr 'Change Location'}" Icon="{ui:SymbolIcon FolderOpen24}" Click="ChangeRootDirectory_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Color24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Appearance'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Customize how the application looks.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <!-- Backdrop Selection -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Window Background Theme'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Select your preferred window background effect.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="BackdropCombo" Grid.Column="1" Width="260" VerticalAlignment="Center" SelectionChanged="BackdropCombo_SelectionChanged">
                                <!-- Items populated dynamically based on OS version -->
                            </ComboBox>
                        </Grid>

                        <!-- Custom Background Image - only shown when Wallpaper Blur is selected -->
                        <StackPanel x:Name="CustomBackgroundPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <Separator Margin="0,0,0,12" Opacity="0.15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Custom Background Image'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Use a custom image instead of your desktop wallpaper. The image will be blurred and darkened automatically.'}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail preview -->
                                    <Border x:Name="CustomBgPreviewBorder"
                                            Width="80" Height="48"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="#30FFFFFF"
                                            Background="#18FFFFFF"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <Image x:Name="CustomBgPreviewImage"
                                                   Stretch="UniformToFill"
                                                   Visibility="Collapsed"/>
                                            <ui:SymbolIcon x:Name="CustomBgPlaceholderIcon"
                                                           Symbol="Image24"
                                                           FontSize="20"
                                                           Foreground="#50FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Controls -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="CustomBgPathLabel"
                                                   Text="{loc:Tr 'PocketMC Default Wallpaper'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8"
                                                   MaxWidth="260"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button x:Name="BtnBrowseCustomBg"
                                                       Content="{loc:Tr 'Browse Image'}"
                                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                                       Appearance="Secondary"
                                                       Click="BrowseCustomBackground_Click"
                                                       Margin="0,0,8,0"/>
                                            <ui:Button x:Name="BtnClearCustomBg"
                                                       Content="{loc:Tr 'Reset to Default Wallpaper'}"
                                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                                       Appearance="Secondary"
                                                       Click="ClearCustomBackground_Click"
                                                       Visibility="Collapsed"
                                                       Margin="0,0,8,0"/>
                                            <ui:Button x:Name="BtnUseDesktopBg"
                                                       Content="{loc:Tr 'Use Desktop Wallpaper'}"
                                                       Icon="{ui:SymbolIcon Desktop24}"
                                                       Appearance="Secondary"
                                                       Click="UseDesktopBackground_Click"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Blur Intensity Slider -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Blur Intensity'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Adjust the background blur strength. Set to 0 for a crisp wallpaper.'}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="WallpaperBlurSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="120"
                                            SmallChange="1"
                                            LargeChange="10"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="WallpaperBlurSlider_ValueChanged"/>
                                    <TextBlock x:Name="WallpaperBlurValueText"
                                               Text="{loc:Tr '80 px'}"
                                               Width="55"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Darkness / Dimming Slider -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Darkness &amp; Dimming'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Adjust dark overlay opacity for text contrast and readability.'}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="WallpaperTintSlider"
                                            Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="WallpaperTintSlider_ValueChanged"/>
                                    <TextBlock x:Name="WallpaperTintValueText"
                                               Text="72%"
                                               Width="55"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Reset Effects Action -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <ui:Button x:Name="BtnResetWallpaperEffects"
                                           Content="{loc:Tr 'Reset Blur &amp; Dimming'}"
                                           Icon="{ui:SymbolIcon ArrowReset24}"
                                           Appearance="Secondary"
                                           Click="ResetWallpaperEffects_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Accent Color Section -->
                        <Separator Margin="0,16,0,12" Opacity="0.15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Accent Color Mode'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Choose the accent color used for interactive controls, highlights, and selections.'}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="AccentPreviewSwatch"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{loc:Tr 'Active Accent Color'}"/>
                                <ComboBox x:Name="AccentModeCombo" 
                                          Width="230" 
                                          SelectionChanged="AccentModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Tr 'Automatic (Windows)'}" Tag="Automatic"/>
                                    <ComboBoxItem Content="{loc:Tr 'Custom Color'}" Tag="Custom"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="CustomAccentPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="{loc:Tr 'Preset Colors'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <WrapPanel x:Name="ColorSwatchPanel" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr 'Custom Hex:'}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Margin="0,0,8,0"/>
                                <ui:TextBox x:Name="HexColorInput"
                                            Width="120"
                                            PlaceholderText="{loc:Tr '#008B00'}"
                                            MaxLength="7"
                                            ClearButtonEnabled="False"
                                            KeyDown="HexColorInput_KeyDown"/>
                                <ui:Button x:Name="BtnApplyHex"
                                           Content="{loc:Tr 'Apply'}"
                                           Appearance="Primary"
                                           Margin="8,0,0,0"
                                           Click="ApplyHexColor_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Notifications'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Manage desktop notifications.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Server Online Notification'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Show a notification when a server finishes starting up and becomes online.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleServerOnlineNotifications"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleServerOnlineNotifications_Changed"
                                             Unchecked="ToggleServerOnlineNotifications_Changed"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Agent Connect Notification'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Show a notification when the Playit agent successfully connects.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleAgentConnectNotifications"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleAgentConnectNotifications_Changed"
                                             Unchecked="ToggleAgentConnectNotifications_Changed"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Remote Control Online Notification'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Show a notification when the remote control service is online and a tunnel is found.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleRemoteControlNotifications"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleRemoteControlNotifications_Changed"
                                             Unchecked="ToggleRemoteControlNotifications_Changed"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'AI Summary Notification'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Show a notification when AI session summarization starts and completes.'}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleAiSummaryNotifications"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Checked="ToggleAiSummaryNotifications_Changed"
                                             Unchecked="ToggleAiSummaryNotifications_Changed"/>
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- DISCORD RICH PRESENCE SECTION -->
                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Games24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Discord Rich Presence'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Customize what is shown on your Discord profile when running servers.'}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <!-- Master Switch: Enable Discord RPC -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Enable Discord Rich Presence'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Show your server status and details on your Discord profile.'}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleDiscordRpc" Grid.Column="1" VerticalAlignment="Center"
                                             Checked="ToggleDiscordRpc_Changed" Unchecked="ToggleDiscordRpc_Changed"/>
                        </Grid>

                        <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

                        <!-- Sub-options container disabled if master toggle is off -->
                        <StackPanel x:Name="DiscordRpcOptionsPanel" IsEnabled="{Binding IsChecked, ElementName=ToggleDiscordRpc}">
                            <!-- Live Profile Previews -->
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{loc:Tr 'Live Profile Preview'}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Active Server Preview -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Tr 'Active Server'}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="2,0,0,6"/>
                                        <ui:Card x:Name="PreviewOnlineCard"
                                                 Padding="14,12"
                                                 VerticalAlignment="Stretch">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header: Playing ... -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:Tr 'Playing'}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="•••"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,2,0"/>
                                                </Grid>

                                                <!-- Main Content: Artwork + Text -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Artwork (56x56) -->
                                                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <!-- Server Software Logo (Paper) (borderless) -->
                                                        <Border x:Name="PreviewOnlineSoftwareBorder"
                                                                CornerRadius="8"
                                                                ClipToBounds="True">
                                                            <Image x:Name="PreviewOnlineSoftwareLogo"
                                                                   Source="pack://application:,,,/Assets/papermc.png"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                        </Border>

                                                        <!-- PocketMC Logo Fallback (borderless) -->
                                                        <Image x:Name="PreviewOnlinePocketFallback"
                                                               Source="pack://application:,,,/Assets/logo.png"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Visibility="Collapsed"/>

                                                        <!-- Small PocketMC Badge -->
                                                        <Border x:Name="PreviewOnlineSmallBadge"
                                                                Width="22" Height="22"
                                                                CornerRadius="11"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,-3,-3"
                                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderThickness="2">
                                                            <Image Source="pack://application:,,,/Assets/logo.png"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Profile Metadata Lines -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Tr 'PocketMC'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="PreviewOnlineDetails"
                                                                   Text="{loc:Tr 'Hosting Survival World'}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"/>
                                                        <TextBlock x:Name="PreviewOnlineState"
                                                                   Text="{loc:Tr '0/20 Players • cynthia-publishing.tun.ply.gg'}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Games24"
                                                                           FontSize="13"
                                                                           Foreground="#237F52"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"/>
                                                            <TextBlock Text="2:30"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="#237F52"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Download Action Button -->
                                                <ui:Button x:Name="PreviewOnlineButton"
                                                           Grid.Row="2"
                                                           Content="{loc:Tr 'Download PocketMC'}"
                                                           Appearance="Secondary"
                                                           HorizontalAlignment="Stretch"
                                                           Height="32"
                                                           Margin="0,12,0,0"/>
                                            </Grid>
                                        </ui:Card>
                                    </StackPanel>

                                    <!-- Column 2: Idle Status Preview -->
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="2,0,0,6">
                                            <TextBlock Text="{loc:Tr 'Idle State'}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="PreviewIdleStatusText"
                                                       Text="{loc:Tr 'Hidden when idle'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                        <ui:Card x:Name="PreviewIdleCard"
                                                 Padding="14,12"
                                                 VerticalAlignment="Stretch">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header: Playing ... -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:Tr 'Playing'}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="•••"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,2,0"/>
                                                </Grid>

                                                <!-- Main Content: Artwork + Text -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- PocketMC Logo (borderless) -->
                                                    <Image Grid.Column="0"
                                                           Width="56" Height="56"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Top"
                                                           Source="pack://application:,,,/Assets/logo.png"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="Fant"/>

                                                    <!-- Profile Metadata Lines -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Tr 'PocketMC'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{loc:Tr 'Managing Servers'}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"/>
                                                        <TextBlock Text="{loc:Tr 'Idle'}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Games24"
                                                                           FontSize="13"
                                                                           Foreground="#237F52"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"/>
                                                            <TextBlock Text="0:55"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="#237F52"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Download Action Button -->
                                                <ui:Button x:Name="PreviewIdleButton"
                                                           Grid.Row="2"
                                                           Content="{loc:Tr 'Download PocketMC'}"
                                                           Appearance="Secondary"
                                                           HorizontalAlignment="Stretch"
                                                           Height="32"
                                                           Margin="0,12,0,0"/>
                                            </Grid>
                                        </ui:Card>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

                            <!-- Show Idle Presence -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show status when idle'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Keep PocketMC visible on your Discord profile even when no servers are running.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowIdle" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>

                            <!-- Show Server Name -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show server instance name'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Display your custom server name instead of a generic Minecraft title.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowServerName" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>

                            <!-- Show Player Count -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show online player count'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Display the number of connected players and total server capacity.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowPlayerCount" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>

                            <!-- Show Server Address -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show server connection address'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Display your server address so friends can see where to connect.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowServerAddress" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>

                            <!-- Show Server Software and Version -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show server software and version'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Display the server software platform and Minecraft version.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowVersionAndEngine" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>

                            <!-- Show Server Software Logo -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show server software logo'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Display the server software icon instead of the default PocketMC logo.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowSoftwareIcon" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>

                            <!-- Show Download Button -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Show PocketMC download button'}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{loc:Tr 'Add a button on your profile linking friends to download PocketMC.'}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleDiscordShowDownloadButton" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="DiscordRpcOption_Changed" Unchecked="DiscordRpcOption_Changed"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Cloud24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Cloud Backups'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Native cloud backup integration for disaster recovery.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16" DataContext="{Binding CloudBackups, RelativeSource={RelativeSource AncestorType=Page}}">
                        <!-- Toggles -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 'Enable Cloud Backups'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Text="{loc:Tr 'Master toggle to allow instances to upload backups to configured providers.'}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding EnableCloudBackups, Mode=TwoWay}"/>
                        </Grid>

                        <Separator Margin="0,16" Opacity="0.15"/>

                        <ItemsControl ItemsSource="{Binding ProviderViewModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Cloud24" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="24"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProviderType}" FontSize="14" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding AccountInfo}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}"/>
                                            <ui:Button Content="{loc:Tr 'Connect'}" Command="{Binding ConnectCommand}" Appearance="Primary" Margin="0,0,8,0" Visibility="{Binding IsConnected, Converter={StaticResource InvertedVisibilityConverter}}" />
                                            <ui:Button Content="{loc:Tr 'Disconnect'}" Command="{Binding DisconnectCommand}" Appearance="Danger" Visibility="{Binding IsConnected, Converter={StaticResource VisibleIfTrue}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon Key24}" Margin="0,0,0,12">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'API Configuration'}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr 'Configure third-party API keys for services like CurseForge.'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel Margin="16,8,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Tr 'CurseForge API Key'}" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{loc:Tr '从 '}"/>
                                    <Hyperlink NavigateUri="https://console.curseforge.com/#/api-keys/" RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                        <Run Text="{loc:Tr 'CurseForge Console'}"/>
                                    </Hyperlink>
                                    <Run Text="{loc:Tr ' 获取免费密钥以访问 CurseForge 附加内容。'}"/>
                                </TextBlock>
