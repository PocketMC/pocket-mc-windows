                                <ComboBoxItem Content="{loc:Tr 'OpenAI'}"/>
                                <ComboBoxItem Content="{loc:Tr 'Anthropic Claude'}"/>
                                <ComboBoxItem Content="{loc:Tr 'Mistral AI'}"/>
                                <ComboBoxItem Content="{loc:Tr 'Groq'}"/>
                                <ComboBoxItem Content="{loc:Tr 'Ollama'}"/>
                            </ComboBox>
